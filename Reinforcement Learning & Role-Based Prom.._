{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPOFB3r3vP3a8HJArTXd8D2"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","metadata":{"id":"2f6bed47"},"source":["## Setup API Keys\n","\n","To use the Groq and Hugging Face APIs, you'll need API keys. If you don't already have them, create keys from their respective platforms.\n","\n","In Colab, add these keys to the secrets manager under the \"🔑\" icon in the left panel. Name them `GROQ_API_KEY` and `HF_API_KEY`. These secrets will be loaded into the `config.py` file.\n","\n"]},{"cell_type":"code","metadata":{"id":"33e3f76a"},"source":["# Used to securely store your API key\n","from google.colab import userdata\n","\n","# Create a dummy config.py to load API keys from Colab secrets\n","with open('config.py', 'w') as f:\n","    f.write('GROQ_API_KEY = userdata.get(\"GROQ_API_KEY\", None)\\n')\n","    f.write('HF_API_KEY = userdata.get(\"HF_API_KEY\", None)\\n')\n","    f.write('GROQ_MODELS = [\"llama-3.1-8b-instant\", \"mixtral-8x7b-32768\"]\\n')\n","    f.write('HF_MODELS = [\"meta-llama/Llama-3.1-8B-Instruct\"]\\n')"],"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"z8feC3odGCmt"},"outputs":[],"source":["# groq.py  (pip install openai)\n","import config\n","from openai import OpenAI\n","\n","GROQ_URL = \"https://api.groq.com/openai/v1\"\n","MODELS = getattr(config, \"GROQ_MODELS\", [\"llama-3.1-8b-instant\", \"mixtral-8x7b-32768\"])\n","\n","def generate_response(prompt: str, temperature: float = 0.3, max_tokens: int = 512) -> str:\n","    key = getattr(config, \"GROQ_API_KEY\", None)\n","    if not key:\n","        return \"Error: GROQ_API_KEY missing in config.py\"\n","    c = OpenAI(api_key=key, base_url=GROQ_URL)\n","\n","    last_err = None\n","    for m in MODELS:\n","        try:\n","            r = c.chat.completions.create(\n","                model=m,\n","                messages=[{\"role\": \"user\", \"content\": prompt}],\n","                temperature=temperature,\n","                max_tokens=max_tokens,\n","            )\n","            return r.choices[0].message.content\n","        except Exception as e:\n","            last_err = e\n","\n","    return (\n","        \"Groq model failed.\\n\"\n","        f\"Tried models: {MODELS}\\n\"\n","        \"Fix:\\n\"\n","        \"1) Switch to hf by importing hf.py in main.py OR\\n\"\n","        \"2) Replace Groq model in groq.py (GROQ_MODELS).\\n\"\n","        f\"Details: {type(last_err).__name__}: {last_err}\"\n","    )"]},{"cell_type":"code","source":["# Choose ONE provider by importing it:\n","\n","#Change groq --> hf to use hugging face API\n","#Change hf --> groq to use groq API\n","from groq import generate_response\n","# from groq import generate_response\n","\n","def reinforcement_learning_activity():\n","    print(\"\\n=== REINFORCEMENT LEARNING ACTIVITY ===\\n\")\n","    prompt = input(\"Enter a prompt for the AI model (e.g., 'Describe the lion'): \").strip()\n","    if not prompt:\n","        print(\"Please enter a prompt to run the activity.\")\n","        return\n","\n","    initial_response = generate_response(prompt, temperature=0.3, max_tokens=1024)\n","    print(f\"\\nInitial AI Response: {initial_response}\")\n","\n","    # Rating + feedback (simulated RL)\n","    try:\n","        rating = int(input(\"Rate the response from 1 (bad) to 5 (good): \").strip())\n","        if rating < 1 or rating > 5:\n","            print(\"Invalid rating. Using 3.\")\n","            rating = 3\n","    except ValueError:\n","        print(\"Invalid rating. Using 3.\")\n","        rating = 3\n","\n","    feedback = input(\"Provide feedback for improvement: \").strip()\n","    improved_response = f\"{initial_response} (Improved with your feedback: {feedback})\"\n","    print(f\"\\nImproved AI Response: {improved_response}\")\n","\n","    print(\"\\nReflection:\")\n","    print(\"1. How did the model's response improve with feedback?\")\n","    print(\"2. How does reinforcement learning help AI to improve its performance over time?\")\n","\n","def role_based_prompt_activity():\n","    print(\"\\n=== ROLE-BASED PROMPTS ACTIVITY ===\\n\")\n","    category = input(\"Enter a category (e.g., science, history, math): \").strip()\n","    item = input(f\"Enter a specific {category} topic (e.g., 'photosynthesis' for science): \").strip()\n","\n","    if not category or not item:\n","        print(\"Please fill in both fields to run the activity.\")\n","        return\n","\n","    teacher_prompt = f\"You are a teacher. Explain {item} in simple terms.\"\n","    expert_prompt = f\"You are an expert in {category}. Explain {item} in a detailed, technical manner.\"\n","\n","    teacher_response = generate_response(teacher_prompt, temperature=0.3, max_tokens=1024)\n","    expert_response = generate_response(expert_prompt, temperature=0.3, max_tokens=1024)\n","\n","    print(f\"\\n--- Teacher's Perspective ---\\n{teacher_response}\")\n","    print(f\"\\n--- Expert's Perspective ---\\n{expert_response}\")\n","\n","    print(\"\\nReflection:\")\n","    print(\"1. How did the AI's response differ between the teacher's and expert's perspectives?\")\n","    print(\"2. How can role-based prompts help tailor AI responses for different contexts?\")\n","\n","def run_activity():\n","    print(\"\\n=== AI Learning Activity ===\")\n","    print(\"Choose an activity:\")\n","    print(\"1) Reinforcement Learning\")\n","    print(\"2) Role-Based Prompts\")\n","    choice = input(\"> \").strip()\n","\n","    if choice == \"1\":\n","        reinforcement_learning_activity()\n","    elif choice == \"2\":\n","        role_based_prompt_activity()\n","    else:\n","        print(\"Invalid choice. Please choose 1 or 2.\")\n","\n","if __name__ == \"__main__\":\n","    run_activity()\n"],"metadata":{"id":"RBosmSYvHk1Y"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =====================================================\n","# AI Learning Activities\n","# Choose ONE provider\n","# Change groq --> hf to use Hugging Face API\n","# =====================================================\n","\n","from datetime import datetime\n","import time\n","\n","# Import AI provider\n","from groq import generate_response\n","# from hf import generate_response\n","\n","\n","# -----------------------------\n","# Utility Functions\n","# -----------------------------\n","class Color:\n","    HEADER = \"\\033[95m\"\n","    BLUE = \"\\033[94m\"\n","    GREEN = \"\\033[92m\"\n","    YELLOW = \"\\033[93m\"\n","    RED = \"\\033[91m\"\n","    END = \"\\033[0m\"\n","\n","\n","def save_to_file(activity, content):\n","    filename = \"AI_Activity_Log.txt\"\n","\n","    with open(filename, \"a\", encoding=\"utf-8\") as file:\n","        file.write(\"\\n\")\n","        file.write(\"=\" * 60 + \"\\n\")\n","        file.write(f\"Activity : {activity}\\n\")\n","        file.write(f\"Date     : {datetime.now()}\\n\")\n","        file.write(content)\n","        file.write(\"\\n\" + \"=\" * 60 + \"\\n\")\n","\n","    print(f\"\\n{Color.GREEN}Results saved to {filename}{Color.END}\")\n","\n","\n","# -----------------------------\n","# Reinforcement Learning Activity\n","# -----------------------------\n","def reinforcement_learning_activity():\n","\n","    print(f\"\\n{Color.HEADER}=== REINFORCEMENT LEARNING ACTIVITY ==={Color.END}\\n\")\n","\n","    prompt = input(\"Enter a prompt: \").strip()\n","\n","    if not prompt:\n","        print(\"Prompt cannot be empty.\")\n","        return\n","\n","    print(\"\\nGenerating AI response...\")\n","\n","    start = time.time()\n","\n","    initial_response = generate_response(\n","        prompt,\n","        temperature=0.3,\n","        max_tokens=1024\n","    )\n","\n","    end = time.time()\n","\n","    print(f\"\\n{Color.BLUE}Initial Response:{Color.END}\")\n","    print(initial_response)\n","\n","    print(f\"\\nTime Taken: {end-start:.2f} seconds\")\n","\n","    # Rating\n","    while True:\n","        try:\n","            rating = int(input(\"\\nRate response (1-5): \"))\n","\n","            if 1 <= rating <= 5:\n","                break\n","\n","            print(\"Enter a value between 1 and 5.\")\n","\n","        except ValueError:\n","            print(\"Please enter a valid number.\")\n","\n","    feedback = input(\"Provide improvement feedback: \")\n","\n","    improvement_prompt = f\"\"\"\n","Prompt:\n","{prompt}\n","\n","Original Response:\n","{initial_response}\n","\n","User Rating: {rating}/5\n","\n","Feedback:\n","{feedback}\n","\n","Rewrite the response using the feedback.\n","\"\"\"\n","\n","    print(\"\\nImproving response...\\n\")\n","\n","    improved_response = generate_response(\n","        improvement_prompt,\n","        temperature=0.7,\n","        max_tokens=1024\n","    )\n","\n","    print(f\"{Color.GREEN}Improved Response:{Color.END}\")\n","    print(improved_response)\n","\n","    print(\"\\nReflection Questions\")\n","    print(\"-------------------------\")\n","    print(\"1. How did the response improve?\")\n","    print(\"2. What changes were made based on feedback?\")\n","    print(\"3. Why is reinforcement learning useful?\")\n","\n","    log = f\"\"\"\n","Prompt:\n","{prompt}\n","\n","Initial Response:\n","{initial_response}\n","\n","Rating:\n","{rating}\n","\n","Feedback:\n","{feedback}\n","\n","Improved Response:\n","{improved_response}\n","\"\"\"\n","\n","    save_to_file(\"Reinforcement Learning\", log)\n","\n","\n","# -----------------------------\n","# Role Based Prompt Activity\n","# -----------------------------\n","def role_based_prompt_activity():\n","\n","    print(f\"\\n{Color.HEADER}=== ROLE BASED PROMPTS ACTIVITY ==={Color.END}\\n\")\n","\n","    category = input(\"Enter category: \").strip()\n","    topic = input(\"Enter topic: \").strip()\n","\n","    if category == \"\" or topic == \"\":\n","        print(\"Category and Topic are required.\")\n","        return\n","\n","    teacher_prompt = (\n","        f\"You are a school teacher. \"\n","        f\"Explain {topic} in simple language with an example.\"\n","    )\n","\n","    expert_prompt = (\n","        f\"You are an expert in {category}. \"\n","        f\"Provide a detailed explanation of {topic}, \"\n","        f\"including technical concepts and real-world applications.\"\n","    )\n","\n","    print(\"\\nGenerating responses...\\n\")\n","\n","    teacher_response = generate_response(\n","        teacher_prompt,\n","        temperature=0.3,\n","        max_tokens=1024\n","    )\n","\n","    expert_response = generate_response(\n","        expert_prompt,\n","        temperature=0.3,\n","        max_tokens=1024\n","    )\n","\n","    print(f\"{Color.BLUE}Teacher Perspective{Color.END}\")\n","    print(\"--------------------------------\")\n","    print(teacher_response)\n","\n","    print()\n","\n","    print(f\"{Color.GREEN}Expert Perspective{Color.END}\")\n","    print(\"--------------------------------\")\n","    print(expert_response)\n","\n","    print(\"\\nReflection Questions\")\n","    print(\"-------------------------\")\n","    print(\"1. Compare both responses.\")\n","    print(\"2. Which audience would benefit from each?\")\n","    print(\"3. How do role-based prompts improve AI outputs?\")\n","\n","    log = f\"\"\"\n","Category:\n","{category}\n","\n","Topic:\n","{topic}\n","\n","Teacher Response:\n","{teacher_response}\n","\n","Expert Response:\n","{expert_response}\n","\"\"\"\n","\n","    save_to_file(\"Role Based Prompt\", log)\n","\n","\n","# -----------------------------\n","# Main Menu\n","# -----------------------------\n","def run_activity():\n","\n","    while True:\n","\n","        print(f\"\\n{Color.YELLOW}\")\n","        print(\"=\" * 40)\n","        print(\"      AI LEARNING ACTIVITIES\")\n","        print(\"=\" * 40)\n","        print(Color.END)\n","\n","        print(\"1. Reinforcement Learning\")\n","        print(\"2. Role-Based Prompts\")\n","        print(\"3. Exit\")\n","\n","        choice = input(\"\\nChoose an option: \").strip()\n","\n","        if choice == \"1\":\n","            reinforcement_learning_activity()\n","\n","        elif choice == \"2\":\n","            role_based_prompt_activity()\n","\n","        elif choice == \"3\":\n","            print(\"\\nThank you for using AI Learning Activities!\")\n","            break\n","\n","        else:\n","            print(\"Invalid choice.\")\n","\n","\n","# -----------------------------\n","# Program Entry\n","# -----------------------------\n","if __name__ == \"__main__\":\n","\n","    try:\n","        run_activity()\n","\n","    except KeyboardInterrupt:\n","        print(\"\\nProgram terminated by user.\")\n","\n","    except Exception as e:\n","        print(f\"\\nUnexpected Error: {e}\")"],"metadata":{"id":"h97_MTdo-WXm"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#hf.py\n","import config\n","from huggingface_hub import InferenceClient\n","\n","MODELS = getattr(\n","    config,\n","    \"HF_MODELS\",\n","    [\"meta-llama/Llama-3.1-8B-Instruct\"],\n",")\n","\n","def generate_response(prompt: str, temperature: float = 0.3, max_tokens: int = 512) -> str:\n","    key = getattr(config, \"HF_API_KEY\", None)\n","    if not key:\n","        return \"Error: HF_API_KEY missing in config.py\"\n","\n","    last_err = None\n","    for m in MODELS:\n","        try:\n","            c = InferenceClient(model=m, token=key)\n","            r = c.chat_completion(\n","                messages=[{\"role\": \"user\", \"content\": prompt}],\n","                temperature=temperature,\n","                max_tokens=max_tokens,\n","            )\n","            return r.choices[0].message.content\n","        except Exception as e:\n","            last_err = e\n","\n","    return (\n","        \"Hugging Face model failed.\\n\"\n","        f\"Tried models: {MODELS}\\n\"\n","        \"Fix:\\n\"\n","        \"1) Switch to Groq by importing groq.py in main.py OR\\n\"\n","        \"2) Replace HF model in hf.py (HF_MODELS).\\n\"\n","        f\"Details: {type(last_err).__name__}: {last_err}\"\n","    )\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":383},"id":"l8FTisPZHzgY","executionInfo":{"status":"error","timestamp":1780652309789,"user_tz":-330,"elapsed":67,"user":{"displayName":"Nivedita Codingal","userId":"07680548725523928187"}},"outputId":"49fb8eea-6f73-4f4f-f940-0479a98987c5"},"execution_count":null,"outputs":[{"output_type":"error","ename":"ModuleNotFoundError","evalue":"No module named 'config'","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mModuleNotFoundError\u001b[0m                       Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_3039/119313798.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[0;32m----> 1\u001b[0;31m \u001b[0;32mimport\u001b[0m \u001b[0mconfig\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m      2\u001b[0m \u001b[0;32mfrom\u001b[0m \u001b[0mhuggingface_hub\u001b[0m \u001b[0;32mimport\u001b[0m \u001b[0mInferenceClient\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      3\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      4\u001b[0m MODELS = getattr(\n\u001b[1;32m      5\u001b[0m     \u001b[0mconfig\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mModuleNotFoundError\u001b[0m: No module named 'config'","","\u001b[0;31m---------------------------------------------------------------------------\u001b[0;32m\nNOTE: If your import is failing due to a missing package, you can\nmanually install dependencies using either !pip or !apt.\n\nTo view examples of installing some common dependencies, click the\n\"Open Examples\" button below.\n\u001b[0;31m---------------------------------------------------------------------------\u001b[0m\n"],"errorDetails":{"actions":[{"action":"open_url","actionText":"Open Examples","url":"/notebooks/snippets/importing_libraries.ipynb"}]}}]},{"cell_type":"code","source":[],"metadata":{"id":"bYwYFP_LJaBT"},"execution_count":null,"outputs":[]}]}