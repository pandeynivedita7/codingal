{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":10,"metadata":{"id":"GdukIR5h7A4c","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1784893678602,"user_tz":-240,"elapsed":48,"user":{"displayName":"Cadion Estrella","userId":"13419058749219153643"}},"outputId":"66ad6123-cc63-4758-ba91-4232c637d14e"},"outputs":[{"output_type":"stream","name":"stdout","text":["=== Quiz Score Finder (n = 11 scores) ===\n","Scores: [12, 25, 33, 41, 50, 67, 72, 85, 91, 98, 15] | Target: 98\n","\n"]}],"source":["# QUIZ SCORE FINDER\n","# Topics: O(log n) | Binary Search | Recursion | Recursive Time | Space | Complexity Ladder\n","\n","\n","# PART 1: Setup — 10 sorted quiz scores, target = 98, three search methods\n","\n","scores = [12, 25, 33, 41, 50, 67, 72, 85, 91, 98]\n","n, target = len(scores), 98\n","print(\"=== Quiz Score Finder (n =\", n, \"scores) ===\")\n","print(\"Scores:\", scores, \"| Target:\", target)\n","print()"]},{"cell_type":"code","source":["# PART 2: Linear Search — O(n)\n","# Scans every score from the start. Target at the end = worst case = n steps.\n","\n","steps = 0\n","for i in range(n):\n","    steps += 1\n","    if scores[i] == target:\n","        print(\"Linear search  : index =\", i, \"| steps =\", steps, \"| O(n)\")\n","        break\n","print()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JSrvBD7R7WPX","executionInfo":{"status":"ok","timestamp":1784893678615,"user_tz":-240,"elapsed":14,"user":{"displayName":"Cadion Estrella","userId":"13419058749219153643"}},"outputId":"e693abaf-dcff-4ca1-8fc2-674f7b3eab53"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Linear search  : index = 9 | steps = 10 | O(n)\n","\n"]}]},{"cell_type":"code","source":["# PART 3: Binary Search — O(log n)\n","# lo and hi mark the search window. mid is the midpoint. Each step halves the window.\n","\n","lo, hi, steps = 0, n - 1, 0\n","while lo <= hi:\n","    mid = (lo + hi) // 2\n","    steps += 1\n","    if scores[mid] == target:\n","        print(\"Binary search  : index =\", mid, \"| steps =\", steps, \"| O(log n)\")\n","        break\n","    elif scores[mid] < target:\n","        lo = mid + 1\n","    else:\n","        hi = mid - 1\n","print()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"a_vjnh837hiv","executionInfo":{"status":"ok","timestamp":1784893678618,"user_tz":-240,"elapsed":2,"user":{"displayName":"Cadion Estrella","userId":"13419058749219153643"}},"outputId":"fff798ac-e648-46a2-c134-ebea88afcbfc"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Binary search  : index = 9 | steps = 3 | O(log n)\n","\n"]}]},{"cell_type":"code","source":["# PART 4: Recursive Binary Search — O(log n) time, O(log n) stack space\n","# Same logic as PART 3. The function calls a smaller version of itself.\n","# Each recursive call adds one frame to the call stack.\n","\n","def binary_search_rec(scores, lo, hi, target, calls=0):\n","    calls += 1\n","    if lo > hi:\n","        return -1, calls\n","    mid = (lo + hi) // 2\n","    if scores[mid] == target:\n","        return mid, calls\n","    elif scores[mid] < target:\n","        return binary_search_rec(scores, mid + 1, hi, target, calls)\n","    else:\n","        return binary_search_rec(scores, lo, mid - 1, target, calls)\n","\n","result, calls = binary_search_rec(scores, 0, n - 1, target)\n","print(\"Recursive search : index =\", result, \"| calls =\", calls, \"| O(log n)\")\n","print()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9E82575P7WJg","executionInfo":{"status":"ok","timestamp":1784893678626,"user_tz":-240,"elapsed":6,"user":{"displayName":"Cadion Estrella","userId":"13419058749219153643"}},"outputId":"283020ce-4d93-4932-808c-8411be066c57"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Recursive search : index = 9 | calls = 3 | O(log n)\n","\n"]}]},{"cell_type":"code","source":["# PART 5: Space Complexity and Complexity Ladder\n","# Iterative: O(1) space — only lo, hi, mid. Recursive: O(log n) — one frame per call.\n","\n","print(\"=== Space and Complexity Summary ===\")\n","print(\"Iterative : O(1) space  — only lo, hi, mid\")\n","print(\"Recursive : O(log n) space —\", calls, \"stack frames for n =\", n)\n","print()\n","print(\"Complexity ladder (n =\", n, \"):\")\n","print(\"O(1)     : 1 step   — constant, never grows\")\n","print(\"O(log n) :\", steps, \"steps  — halving, grows slowly\")\n","print(\"O(n)     :\", n, \"steps  — linear, grows with n\")\n","print(\"O(n^2)   :\", n * n, \"steps — quadratic, grows fast!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ENDGaOyr7V-g","executionInfo":{"status":"ok","timestamp":1784893678636,"user_tz":-240,"elapsed":9,"user":{"displayName":"Cadion Estrella","userId":"13419058749219153643"}},"outputId":"21d47f08-dc59-43c0-88d7-0ba8f42aa660"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Space and Complexity Summary ===\n","Iterative : O(1) space  — only lo, hi, mid\n","Recursive : O(log n) space — 3 stack frames for n = 11\n","\n","Complexity ladder (n = 11 ):\n","O(1)     : 1 step   — constant, never grows\n","O(log n) : 3 steps  — halving, grows slowly\n","O(n)     : 11 steps  — linear, grows with n\n","O(n^2)   : 121 steps — quadratic, grows fast!\n"]}]}]}