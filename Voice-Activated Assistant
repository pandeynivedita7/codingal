pplications and does not directly output audio in the Colab browser environment. Therefore, we'll rely on `gTTS` and `IPython.display.Audio` for speech output."]},{"cell_type":"code","metadata":{"id":"d38d4126"},"source":["# Install necessary libraries\n","!pip install -q SpeechRecognition gtts pydub\n","\n","# Import libraries\n","import speech_recognition as sr\n","from gtts import gTTS\n","from IPython.display import Audio, display, Javascript\n","from google.colab.output import eval_js\n","from base64 import b64decode\n","import io\n","from pydub import AudioSegment\n","from datetime import datetime"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"d6bd8369"},"source":["### Text-to-Speech (speak function)\n","\n","This function will use `gTTS` to convert text into an audio file and then play it back in the Colab environment."]},{"cell_type":"code","metadata":{"id":"54ce03b7"},"source":["def speak(text):\n","    print(f\"Assistant: {text}\")\n","    tts = gTTS(text=text, lang='en')\n","    # Save the audio to a BytesIO object instead of a file for direct playback\n","    fp = io.BytesIO()\n","    tts.write_to_fp(fp)\n","    fp.seek(0)\n","    display(Audio(fp.read(), autoplay=True))\n","\n","# Test the speak function\n","speak(\"Hello, I am your updated voice assistant.\")"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"14205898"},"source":["### Audio Recording from Browser (record_audio function)\n","\n","This function will capture audio from your browser's microphone, save it as a WebM file, and then convert it to a WAV format for `speech_recognition`."]},{"cell_type":"code","metadata":{"id":"a66f2d47"},"source":["def record_audio():\n","    # JavaScript to record audio from the browser\n","    JS_RECORD = \"\"\"\n","    async function recordAudio() {\n","      const div = document.createElement('div');\n","      const startButton = document.createElement('button');\n","      startButton.textContent = 'Start Recording';\n","      div.appendChild(startButton);\n","\n","      const stopButton = document.createElement('button');\n","      stopButton.textContent = 'Stop Recording';\n","      div.appendChild(stopButton);\n","\n","      document.body.appendChild(div);\n","\n","      const stream = await navigator.mediaDevices.getUserMedia({audio:true});\n","      const mediaRecorder = new MediaRecorder(stream);\n","      const audioChunks = [];\n","\n","      mediaRecorder.addEventListener('dataavailable', event => {\n","        audioChunks.push(event.data);\n","      });\n","\n","      startButton.onclick = () => {\n","        mediaRecorder.start();\n","        startButton.disabled = true;\n","        stopButton.disabled = false;\n","        console.log('Recording started...');\n","      };\n","\n","      stopButton.onclick = () => {\n","        mediaRecorder.stop();\n","        startButton.disabled = false;\n","        stopButton.disabled = true;\n","        console.log('Recording stopped.');\n","      };\n","\n","      stopButton.disabled = true; // Disable stop until recording starts\n","\n","      await new Promise(resolve => mediaRecorder.addEventListener('stop', resolve));\n","\n","      const audioBlob = new Blob(audioChunks);\n","      const reader = new FileReader();\n","      reader.readAsDataURL(audioBlob);\n","\n","      return new Promise(resolve => {\n","        reader.onloadend = () => resolve(reader.result);\n","      });\n","    }\n","    \"\"\"\n","\n","    display(Javascript(JS_RECORD))\n","    data = eval_js(\"recordAudio()\")\n","    binary = b64decode(data.split(',')[1])\n","\n","    # Save as webm initially\n","    with open('recorded_audio.webm', 'wb') as f:\n","        f.write(binary)\n","\n","    # Convert webm to wav using pydub\n","    sound = AudioSegment.from_file(\"recorded_audio.webm\")\n","    sound.export(\"recorded_audio.wav\", format=\"wav\")\n","    print(\"Audio recorded and converted to WAV.\")\n","\n","# Test the record_audi