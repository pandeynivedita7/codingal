e(r => {\n","        const reader = new FileReader();\n","        reader.onloadend = () => r(reader.result);\n","        reader.readAsDataURL(blob);\n","      });\n","\n","      return dataUrl;\n","    }\n","    \"\"\"\n","\n","    display(Javascript(js_code))\n","    audio_data = eval_js(\"recordAudio()\")\n","\n","    binary = b64decode(audio_data.split(',')[1])\n","\n","    with open('recorded.wav', 'wb') as f:\n","        f.write(binary)\n","\n","# ------------------------------------------\n","# Convert Speech to Text\n","# ------------------------------------------\n","\n","def listen():\n","    record()\n","\n","    recognizer = sr.Recognizer()\n","\n","    with sr.AudioFile('recorded.wav') as source:\n","        audio = recognizer.record(source)\n","\n","    try:\n","        command = recognizer.recognize_google(audio)\n","        print(\"You said:\", command)\n","        return command.lower()\n","\n","    except:\n","        speak(\"Sorry, I could not understand.\")\n","        return \"\"\n","\n","# ------------------------------------------\n","# Greeting Function\n","# ------------------------------------------\n","\n","def greet():\n","    hour = datetime.datetime.now().hour\n","\n","    if hour < 12:\n","        speak(\"Good Morning!\")\n","\n","    elif hour < 18:\n","        speak(\"Good Afternoon!\")\n","\n","    else:\n","        speak(\"Good Evening!\")\n","\n","    speak(\"I am Smart Command Pro running in Google Colab.\")\n","\n","# ------------------------------------------\n","# Command Processing\n","# ------------------------------------------\n","\n","def process_command(command):\n","\n","    if \"time\" in command:\n","        current_time = datetime.datetime.now().strftime(\"%I:%M %p\")\n","        speak(f\"The current time is {current_time}\")\n","\n","    elif \"date\" in command:\n","        today = datetime.datetime.now().strftime(\"%d %B %Y\")\n","        speak(f\"Today's date is {today}\")\n","\n","    elif \"how are you\" in command:\n","        speak(\"I am working perfectly.\")\n","\n","    elif \"joke\" in command:\n","        jokes = [\n","            \"Why do programmers hate nature? Too many bugs.\",\n","            \"Why was the computer cold? It forgot to close windows.\",\n","            \"Why do Python programmers wear glasses? Because they cannot C.\"\n","        ]\n","\n","        speak(random.choice(jokes))\n","\n","    elif \"your name\" in command:\n","        speak(\"My name is Smart Command Pro.\")\n","\n","    elif \"bye\" in command or \"exit\" in command:\n","        speak(\"Goodbye!\")\n","        return False\n","\n","    else:\n","        speak(\"Sorry, command not recognized.\")\n","\n","    return True\n","\n","# ------------------------------------------\n","# MAIN PROGRAM\n","# ------------------------------------------\n","\n","greet()\n","\n","running = True\n","\n","while running:\n","    print(\"\\nSpeak your command...\")\n","    command = listen()\n","\n","    if command != \"\":\n","        running = process_command(command)"],"metadata":{"id":"jrLLL1psuVPh"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"rqOoZc1pi92Z"},"outputs":[],"source":["# Import the speech_recognition library for converting audio to text.\n","import speech_recognition as sr\n","\n","# Import the pyttsx3 library for converting text to speech.\n","import pyttsx3\n","\n","# Import the datetime module to get the current time.\n","from datetime import datetime\n","\n","\n","# Define a function to make the assistant speak.\n","def speak(text):\n","    # Initialize the text-to-speech engine.\n","    engine = pyttsx3.init()\n","    # Set the speech rate (words per minute).\n","    engine.setProperty('rate', 150)\n","    # Queue the text to be spoken.\n","    engine.say(text)\n","    # Wait for the speech to finish.\n","    engine.runAndWait()\n","\n","\n","# Define a function to capture audio input from the user.\n","def get_audio():\n","    # Initialize the Recognizer.\n","    r = sr.Recognizer()\n","    # Use the default microphone as the audio source.\n","    with sr.Microphone() as source:\n","        print(\"???? Speak now...\")\n","        # Listen to the audio from the microphone.\n","        audio = r.listen(source)\n","        try:\n","            # Try to recognize the speech using Google's speech recognition.\n","            command = r.recognize_google(audio)\n","            print(f\"✅ You said: {command}\")\n","            # Return the recognized command in lowercase.\n","            return command.lower()\n","        except sr.UnknownValueError:\n","            # Handle cases where speech is unintelligible.\n","            print(\"❌ Could not understand.\")\n","        except sr.RequestError as e:\n","            # Handle API errors (e.g., no internet connection).\n","            print(f\"❌ API Error: {e}\")\n","    # Return an empty string if recognition fails.\n","    return \"\"\n","\n","\n","# Define a function to respond to user commands.\n","def respond_to_command(command):\n","    # Check if \"hello\" is in the command.\n","    if \"hello\" in command:\n","        speak(\"Hi there! How can I help you today?\")\n","    # Check if \"your name\" is in the command.\n","    elif \"your name\" in command:\n","        speak(\"I am your Python voice assistant.\")\n","    # Check if \"time\" is in the command.\n","    elif \"time\" in command:\n","        # Get the current time and format it.\n","        now = datetime.now().strftime(\"%H:%M\")\n","        speak(f\"The time is {now}\")\n","    # Check if \"exit\" or \"stop\" is in the command.\n","    elif \"exit\" in command or \"stop\" in command:\n","        speak(\"Goodbye!\")\n","        # Return False to signal the main loop to stop.\n","        return False\n","    else:\n","        # Default response for unrecognized commands.\n","        speak(\"I'm not sure how to help with that.\")\n","    # Return True to continue the main loop.\n","    return True\n","\n","\n","# Define the main function to run the voice assistant.\n","def main():\n","    speak(\"Voice assistant activated. Say something!\")\n","    # Loop indefinitely until an exit command is given.\n","    while True:\n","        # Get audio input from the user.\n","        command = get_audio()\n","        # If a command is recognized and respond_to_command returns False (exit command),\n","        # then break the loop.\n","        if command and not respond_to_command(command):\n","            break\n","\n","\n","# Ensure main() is called only when the script is executed directly.\n","if __name__ == \"__main__\":\n","    main()"]},{"cell_type":"code","source":["import speech_recognition as sr\n","import pyttsx3\n","from googletrans import Translator  # Google Translate API\n","\n","# Initialize text-to-speech engine\n","def speak(text, language=\"en\"):\n","    engine = pyttsx3.init()\n","    engine.setProperty('rate', 150)  # Speed of speech\n","    voices = engine.getProperty('voices')\n","\n","    # Set voice for English or other language if supported by pyttsx3\n","    if language == \"en\":\n","        engine.setProperty('voice', voices[0].id)  # Default English voice\n","    else:\n","        engine.setProperty('voice', voices[1].id)  # Fallback to another voice if available\n","\n","    engine.say(text)\n","    engine.runAndWait()\n","\n","# Speech-to-Text: Recognize spoken language (English)\n","def speech_to_text():\n","    recognizer = sr.Recognizer()\n","    with sr.Microphone() as source:\n","        print(\"🎤 Please speak now in English...\")\n","        audio = recognizer.listen(source)\n","\n","    try:\n","        print(\"🔍 Recognizing speech...\")\n","        text = recognizer.recognize_google(audio, language=\"en-US\")  # Use English for speech recognition\n","        print(f\"✅ You said: {text}\")\n","        return text\n","    except sr.UnknownValueError:\n","        print(\"❌ Could not understand the audio.\")\n","    except sr.RequestError as e:\n","        print(f\"❌ API Error: {e}\")\n","    return \"\"\n","\n","# Translate text using Google Translate API\n","def translate_text(text, target_language=\"es\"):  # Default target language is Spanish (es)\n","    translator = Translator()\n","    translation = translator.translate(text, dest=target_language)\n","    print(f\"🌍 Translated text: {translation.text}\")\n","    return translation.text\n","\n","# Display language options to the user\n","def display_language_options():\n","    print(\"🌍 Available translation languages: \")\n","    print(\"1. Hindi (hi)\")\n","    print(\"2. Tamil (ta)\")\n","    print(\"3. Telugu (te)\")\n","    print(\"4. Bengali (bn)\")\n","    print(\"5. Marathi (mr)\")\n","    print(\"6. Gujarati (gu)\")\n","    print(\"7. Malayalam (ml)\")\n","    print(\"8. Punjabi (pa)\")\n","\n","    # User selects language\n","    choice = input(\"Please select the target language number (1-8): \")\n","    language_dict = {\n","        \"1\": \"hi\",\n","        \"2\": \"ta\",\n","        \"3\": \"te\",\n","        \"4\": \"bn\",\n","        \"5\": \"mr\",\n","        \"6\": \"gu\",\n","        \"7\": \"ml\",\n","        \"8\": \"pa\"\n","    }\n","\n","    return language_dict.get(choice, \"es\")  # Default to Spanish if invalid input\n","\n","# Main function to combine all steps\n","def main():\n","    # Step 1: Display language options and get user's choice\n","    target_language = display_language_options()\n","\n","    # Step 2: Speech-to-Text (recognizing English speech)\n","    original_text = speech_to_text()\n","\n","    if original_text:\n","        # Step 3: Translate to selected target language\n","        translated_text = translate_text(original_text, target_language=target_language)\n","\n","        # Step 4: Text-to-Speech (Translate output and speak it)\n","        speak(translated_text, language=\"en\")  # Speak the translation in English\n","        print(\"✅ Translation spoken out!\")\n","\n","if __name__ == \"__main__\":\n","    main()\n"],"metadata":{"id":"1dnGSeU1-P3d"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Install required libraries\n","!pip install -q SpeechRecognition googletrans==4.0.0-rc1 gtts pydub\n","\n","import speech_recognition as sr\n","from googletrans import Translator\n","from gtts import gTTS\n","from IPython.display import Audio, display\n","from google.colab import output\n","from base64 import b64decode\n","import io\n","from pydub import AudioSegment\n","\n","# Function to record audio from browser microphone\n","def record_audio():\n","    RECORD = \"\"\"\n","    async function recordAudio() {\n","      const stream = await navigator.mediaDevices.getUserMedia({audio:true});\n","      const mediaRecorder = new MediaRecorder(stream);\n","      const audioChunks = [];\n","\n","      mediaRecorder.addEventListener(\"dataavailable\", event => {\n","        audioChunks.push(event.data);\n","      });\n","\n","      mediaRecorder.start();\n","\n","      await new Promise(resolve => setTimeout(resolve, 5000));\n","\n","      mediaRecorder.stop();\n","\n","      await new Promise(resolve => {\n","        mediaRecorder.addEventListener(\"stop\", resolve);\n","      });\n","\n","      const audioBlob = new Blob(audioChunks);\n","      const reader = new FileReader();\n","      reader.readAsDataURL(audioBlob);\n","\n","      return await new Promise(resolve => {\n","        reader.onloadend = () => resolve(reader.result);\n","      });\n","    }\n","    \"\"\"\n","\n","    display(output.eval_js(RECORD))\n","    data = output.eval_js(\"recordAudio()\")\n","    binary = b64decode(data.split(',')[1])\n","\n","    with open('recorded_audio.webm', 'wb') as f:\n","        f.write(binary)\n","\n","    # Convert webm to wav\n","    sound = AudioSegment.from_file(\"recorded_audio.webm\")\n","    sound.export(\"recorded_audio.wav\", format=\"wav\")\n","\n","# Speech-to-text\n","def speech_to_text():\n","    recognizer = sr.Recognizer()\n","\n","    with sr.AudioFile('recorded_audio.wav') as source:\n","        audio = recognizer.record(source)\n","\n","    try:\n","        text = recognizer.recognize_google(audio, language=\"en-US\")\n","        print(f\"✅ You said: {text}\")\n","        return text\n","    except sr.UnknownValueError:\n","        print(\"❌ Could not understand audio.\")\n","        return \"\"\n","    except sr.RequestError as e:\n","        print(f\"❌ API Error: {e}\")\n","        return \"\"\n","\n","# Translate text\n","def translate_text(text, target_language):\n","    translator = Translator()\n","    translated = translator.translate(text, dest=target_language)\n","    print(f\"🌍 Translated Text: {translated.text}\")\n","    return translated.text\n","\n","# Convert translated text to speech\n","def speak_text(text, lang):\n","    tts = gTTS(text=text, lang=lang)\n","    tts.save(\"translated_audio.mp3\")\n","    display(Audio(\"translated_audio.mp3\", autoplay=True))\n","\n","# Language options\n","def display_language_options():\n","    print(\"🌍 Available Languages:\")\n","    print(\"1. Hindi (hi)\")\n","    print(\"2. Tamil (ta)\")\n","    print(\"3. Telugu (te)\")\n","    print(\"4. Bengali (bn)\")\n","    print(\"5. Marathi (mr)\")\n","    print(\"6. Gujarati (gu)\")\n","    print(\"7. Malayalam (ml)\")\n","    print(\"8. Punjabi (pa)\")\n","\n","    choice = input(\"Select language number (1-8): \")\n","\n","    language_dict = {\n","        \"1\": \"hi\",\n","        \"2\": \"ta\",\n","        \"3\": \"te\",\n","        \"4\": \"bn\",\n","        \"5\": \"mr\",\n","        \"6\": \"gu\",\n","        \"7\": \"ml\",\n","        \"8\": \"pa\"\n","    }\n","\n","    return language_dict.get(choice, \"hi\")\n","\n","# Main function\n","def main():\n","    target_language = display_language_options()\n","\n","    print(\"🎤 Recording will start for 5 seconds...\")\n","    record_audio()\n","\n","    original_text = speech_to_text()\n","\n","    if 