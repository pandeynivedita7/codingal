game window\n","screen = pygame.display.set_mode((screen_width, screen_height))  # Creates the game display surface\n","pygame.display.set_caption(\"Space Invaders\")  # Sets the title of the game window\n","\n","# Colors\n","WHITE = (255, 255, 255)  # Defines a constant for the color white (RGB)\n","RED = (255, 0, 0)  # Defines a constant for the color red (RGB)\n","\n","# Load background\n","try:  # Attempts to load the background image\n","    background_image = pygame.image.load(r\"C:\\Users\\Masth\\Downloads\\background.jpg.jpg\")  # Loads the background image from the specified path\n","    background_image = pygame.transform.scale(background_image, (screen_width, screen_height))  # Scales the background image to fit the screen dimensions\n","except pygame.error as e:  # Catches any Pygame errors during image loading\n","    print(f\"Error loading background: {e}\")  # Prints an error message\n","    sys.exit()  # Exits the game if the background image cannot be loaded\n","\n","# Load player\n","try:  # Attempts to load the player (rocket) image\n","    player_image = pygame.image.load(r\"C:\\Users\\Masth\\Downloads\\rocket.png.png\")  # Loads the player image\n","    player = pygame.transform.scale(player_image, (50, 50))  # Scales the player image to 50x50 pixels\n","except pygame.error as e:  # Catches any Pygame errors during image loading\n","    print(f\"Error loading rocket: {e}\")  # Prints an error message\n","    sys.exit()  # Exits the game if the player image cannot be loaded\n","\n","player_x = (screen_width - 50) // 2  # Sets the initial x-position of the player (centered horizontally)\n","player_y = screen_height - 60  # Sets the initial y-position of the player (near the bottom)\n","player_speed = 5  # Sets the movement speed of the player\n","player_lives = 3  # Sets the initial number of lives for the player\n","\n","# Player bullets\n","player_bullets = []  # Creates an empty list to store active player bullets\n","bullet_speed = 7  # Sets the speed of player bullets\n","\n","# Enemy setup\n","try:  # Attempts to load the enemy image\n","    enemy_image = pygame.image.load(r\"C:\\Users\\Masth\\Downloads\\enemy.png\")  # Loads the enemy image\n","    enemy_image = pygame.transform.scale(enemy_image, (40, 40))  # Scales the enemy image to 40x40 pixels\n","except pygame.error as e:  # Catches any Pygame errors during image loading\n","    print(f\"Error loading alien: {e}\")  # Prints an error message\n","    sys.exit()  # Exits the game if the enemy image cannot be loaded\n","\n","enemies = []  # Creates an empty list to store active enemies\n","enemy_speed = 2  # Sets the movement speed of enemies\n","enemy_bullets = []  # Creates an empty list to store active enemy bullets\n","enemy_bullet_speed = 5  # Sets the speed of enemy bullets\n","spawn_delay = 1000  # ms  # Sets the delay in milliseconds between enemy spawns\n","\n","score = 0  # Initializes the player's score to 0\n","font = pygame.font.Font(None, 36)  # Creates a font object for displaying text (None for default font, size 36)\n","\n","# Timers\n","pygame.time.set_timer(pygame.USEREVENT + 1, spawn_delay)  # Sets a custom event (USEREVENT+1) to trigger enemy spawning at `spawn_delay` intervals\n","pygame.time.set_timer(pygame.USEREVENT + 2, 800)  # Sets a custom event (USEREVENT+2) to trigger enemy shooting at 800ms intervals\n","\n","# Game over flag\n","game_over = False  # A boolean flag to indicate if the game is over\n","\n","# Main game loop\n","running = True  # A boolean flag to keep the game loop running\n","clock = pygame.time.Clock()  # Creates a Clock object to control frame rate\n","\n","while running:  # The main game loop continues as long as `running` is True\n","    clock.tick(60)  # Limits the frame rate to 60 frames per second\n","    screen.blit(background_image, (0, 0))  # Draws the background image at the top-left corner (0,0)\n","\n","    for event in pygame.event.get():  # Iterates through all events captured by Pygame\n","        if event.type == pygame.QUIT:  # Checks if the user clicked the close button\n","            running = False  # Sets `running` to False to exit the game loop\n","\n","        # Spawn enemies\n","        if event.type == pygame.USEREVENT + 1 and not game_over:  # Checks if the enemy spawn event occurred and the game is not over\n","            side = random.choice([\"left\", \"right\"])  # Randomly chooses a side for the enemy to spawn (left or right)\n","            y_pos = random.randint(50, 300)  # Randomly chooses a y-position for the enemy\n","            if side == \"left\":  # If spawning on the left side\n","                x_pos = 0  # Start at x=0\n","                direction = 1  # Move right (positive x-direction)\n","            else:  # If spawning on the right side\n","                x_pos = screen_width - 40  # Start at the right edge, accounting for enemy width\n","                direction = -1  # Move left (negative x-direction)\n","            enemies.append({\"x\": x_pos, \"y\": y_pos, \"dir\": direction})  # Adds a new enemy dictionary to the `enemies` list\n","\n","        # Enemy shooting\n","        if event.type == pygame.USEREVENT + 2 and not game_over:  # Checks if the enemy shooting event occurred and the game is not over\n","            if enemies:  # Ensures there are enemies on screen\n","                shooter = random.choice(enemies)  # Randomly selects an enemy to shoot\n","                enemy_bullets.append({\"x\": shooter[\"x\"] + 20, \"y\": shooter[\"y\"] + 40})  # Adds a new enemy bullet, positioned relative to the shooter\n","\n","    if not game_over:  # Only process game logic if the game is not over\n","        # Player movement\n","        keys = pygame.key.get_pressed()  # Gets the state of all keyboard keys\n","        if keys[pygame.K_LEFT]:  # Checks if the left arrow key is pressed\n","            player_x -= player_speed  # Moves the player left\n","        if keys[pygame.K_RIGHT]:  # Checks if the right arrow key is pressed\n","            player_x += player_speed  # Moves the player right\n","        if keys[pygame.K_SPACE]:  # Checks if the spacebar is pressed\n","            if len(player_bullets) < 5:  # Limits the number of player bullets on screen to 5\n","                player_bullets.append({\"x\": player_x + 20, \"y\": player_y})  # Adds a new player bullet, positioned relative to the player\n","\n","        # Keep player on screen\n","        player_x = max(0, min(player_x, screen_width - 50))  # Clamps the player's x-position to stay within screen bounds\n","\n","        # Move enemies\n","        for enemy in enemies:  # Iterates through each enemy\n","            enemy[\"x\"] += enemy[\"dir\"] * enemy_speed  # Moves the enemy horizontally based on its direction and speed\n","        enemies = [e for e in enemies if 0 <= e[\"x\"] <= screen_width - 40]  # Removes enemies that have moved off-screen\n","\n","        # Move player bullets\n","        for bullet in player_bullets:  # Iterates through each player bullet\n","            bullet[\"y\"] -= bullet_speed  # Moves the bullet upwards\n","        player_bullets = [b for b in player_bullets if b[\"y\"] > 0]  # Removes player bullets that have moved off the top of the screen\n","\n","        # Move enemy bullets\n","        for bullet in enemy_bullets:  # Iterates through each enemy bullet\n","            bullet[\"y\"] += enemy_bullet_speed  # Moves the bullet downwards\n","        enemy_bullets = [b for b in enemy_bullets if b[\"y\"] < screen_height]  # Removes enemy bullets that have moved off the bottom of the screen\n","\n","        # Check collisions: player bullets vs enemies\n","        for bullet in player_bullets[:]:  # Iterates through a copy of the player bullets list to allow removal during iteration\n","            for enemy in enemies[:]:  # Iterates through a copy of the enemies list\n","                if enemy[\"x\"] < bullet[\"x\"] < enemy[\"x\"] + 40 and enemy[\"y\"] < bullet[\"y\"] < enemy[\"y\"] + 40:  # Checks for collision between bullet and enemy (simple bounding box check)\n","                    player_bullets.remove(bullet)  # Removes the hit player bullet\n","                    enemies.remove(enemy)  # Removes the hit enemy\n","                    score += 10  # Increases the score\n","                    break  # Breaks from the inner loop to avoid checking the same bullet against other enemies\n","\n","        # Check collisions: enemy bullets vs player\n","        for bullet in enemy_bullets[:]:  # Iterates through a copy of the enemy bullets list\n","            if player_x < bullet[\"x\"] < player_x + 50 and player_y < bullet[\"y\"] < player_y + 50:  # Checks for collision between enemy bullet and player\n","                enemy_bullets.remove(bullet)  # Removes the hit enemy bullet\n","                player_lives -= 1  # Decreases player lives\n","                if player_lives <= 0:  # Checks if player lives have reached zero\n","                    game_over = True  # Sets the game over flag to True\n","\n","        # Draw player\n","        screen.blit(player, (player_x, player_y))  # Draws the player image on the screen at its current position\n","\n","        # Draw enemies\n","        for enemy in enemies:  # Iterates through each enemy\n","            screen.blit(enemy_image, (enemy[\"x\"], enemy[\"y\"]))  # Draws the enemy image on the screen\n","\n","        # Draw bullets\n","        for bullet in player_bullets:  # Iterates through each player bullet\n","            pygame.draw.rect(screen, WHITE, (bullet[\"x\"], bullet[\"y\"], 5, 10))  # Draws a white rectangle for the player bullet\n","        for bullet in enemy_bullets:  # Iterates through each enemy bullet\n","            pygame.draw.rect(screen, RED, (bullet[\"x\"], bullet[\"y\"], 5, 10))  # Draws a red rectangle for the enemy bullet\n","\n","        # Draw score and lives\n","        score_text = font.render(f\"Score: {score}\", True, WHITE)  # Renders the score text\n","        lives_text = font.render(f\"Lives: {player_lives}\", True, WHITE)  # Renders the lives text\n","        screen.blit(score_text, (10, 10))  # Draws the score text at the top-left\n","        screen.blit(lives_text, (screen_width - 120, 10))  # Draws the lives text at the top-right\n","    else:  # If game_over is True\n","        # Game Over screen\n","        over_text = font.render(\"GAME OVER\", True, RED)  # Renders \"GAME OVER\" text in red\n","        screen.blit(over_text, (screen_width // 2 - 100, screen_height // 2 - 20))  # Draws \"GAME OVER\" text in the center of the screen\n","        score_text = font.render(f\"Final Score: {score}\", True, WHITE)  # Renders the final score text\n","        screen.blit(score_text, (screen_width // 2 - 100, screen_height // 2 + 20))  # Draws the final score below \"GAME OVER\"\n","\n","    pygame.display.flip()  # Updates the entire screen to show what has been drawn\n","\n","pygame.quit()  # Uninitializes all Pygame modules\n","```"]},{"cell_type":"code","source":["import pygame\n","import sys\n","\n","# Initialize Pygame\n","pygame.init()\n","\n","# Constants\n","WIDTH, HEIGHT = 800, 600\n","FPS = 60\n","WHITE = (255, 255, 255)\n","BLACK = (0, 0, 0)\n","RED = (255, 0, 0)\n","BLUE = (0, 100, 255)\n","GREEN = (0, 255, 0)\n","YELLOW = (255, 215, 0)\n","BROWN = (139, 69, 19)\n","\n","# Game variables\n","GRAVITY = 0.8\n","JUMP_STRENGTH = -15\n","PLAYER_SPEED = 5\n","\n","class Player(pygame.sprite.Sprite):\n","    def __init__(self, x, y):\n","        super().__init__()\n","        self.image = pygame.Surface((40, 50))\n","        self.image.fill(RED)\n","        self.rect = self.image.get_rect()\n","        self.rect.x = x\n","        self.rect.y = y\n","        self.vel_y = 0\n","        self.vel_x = 0\n","        self.on_ground = False\n","        self.score = 0\n","        self.lives = 3\n","\n","    def update(self, platforms):\n","        keys = pygame.key.get_pressed()\n","\n","        # Horizontal movement\n","        self.vel_x = 0\n","        if keys[pygame.K_LEFT]:\n","            self.vel_x = -PLAYER_SPEED\n","        if keys[pygame.K_RIGHT]:\n","            self.vel_x = PLAYER_SPEED\n","\n","        # Apply gravity\n","        self.vel_y += GRAVITY\n","\n","        # Jump\n","        if keys[pygame.K_SPACE] and self.on_ground:\n","            self.vel_y = JUMP_STRENGTH\n","            self.on_ground = False\n","\n","        # Update position\n","        self.rect.x += self.vel_x\n","        self.check_collision_x(platforms)\n","\n","        self.rect.y += self.vel_y\n","        self.on_ground = False\n","        self.check_collision_y(platforms)\n","\n","        # Keep player on screen horizontally\n","        if self.rect.left < 0:\n","            self.rect.left = 0\n","        if self.rect.right > WIDTH:\n","            self.rect.right = WIDTH\n","\n","        # Fall off screen (death)\n","        if self.rect.top > HEIGHT:\n","            self.lives -= 1\n","            self.rect.x = 100\n","            self.rect.y = 200\n","            self.vel_y = 0\n","\n","    def check_collision_x(self, platforms):\n","        for platform in platforms:\n","            if self.rect.colliderect(platform.rect):\n","                if self.vel_x > 0:\n","                    self.rect.right = platform.rect.left\n","                elif self.vel_x < 0:\n","                    self.rect.left = platform.rect.right\n","\n","    def check_collision_y(self, platforms):\n","        for platform in platforms:\n","            if self.rect.colliderect(platform.rect):\n","                if self.vel_y > 0:\n","                    self.rect.bottom = platform.rect.top\n","                    self.vel_y = 0\n","                    self.on_ground = True\n","                elif self.vel_y < 0:\n","                    self.rect.top = platform.rect.bottom\n","                    self.vel_y = 0\n","\n","class Platform(pygame.sprite.Sprite):\n","    def __init__(self, x, y, width, height):\n","        super().__init__()\n","        self.image = pygame.Surface((width, height))\n","        self.image.fill(GREEN)\n","        self.rect = self.image.get_rect()\n","        self.rect.x = x\n","        self.rect.y = y\n","\n","class Coin(pygame.sprite.Sprite):\n","    def __init__(self, x, y):\n","        super().__init__()\n","        self.image = pygame.Surface((20, 20))\n","        self.image.fill(YELLOW)\n","        self.rect = self.image.get_rect()\n","        self.rect.x = x\n","        self.rect.y = y\n","\n","class Enemy(pygame.sprite.Sprite):\n","    def __init__(self, x, y, move_range):\n","        super().__init__()\n","        self.image = pygame.Surface((35, 35))\n","        self.image.fill(BROWN)\n","        self.rect = self.image.get_rect()\n","        self.rect.x = x\n","        self.rect.y = y\n","        self.start_x = x\n","        self.move_range = move_range\n","        self.direction = 1\n","        self.speed = 2\n","\n","    def update(self):\n","        self.rect.x += self.speed * self.direction\n","\n","        if self.rect.x > self.start_x + self.move_range or self.rect.x < self.start_x:\n","            self.direction *= -1\n","\n","def main():\n","    screen = pygame.display.set_mode((WIDTH, HEIGHT))\n","    pygame.display.set_caption(\"Mario Platformer\")\n","    clock = pygame.time.Clock()\n","\n","    # Create sprite groups\n","    all_sprites = pygame.sprite.Group()\n","    platforms = pygame.sprite.Group()\n","    coins = pygame.sprite.Group()\n","    enemies = pygame.sprite.Group()\n","\n","    # Create player\n","    player = Player(100, 200)\n","    all_sprites.add(player)\n","\n","    # Create platforms\n","    platform_data = [\n","        (0, HEIGHT - 40, WIDTH, 40),  # Ground\n","        (200, 450, 150, 20),\n","        (400, 350, 150, 20),\n","        (600, 250, 150, 20),\n","        (100, 150, 150, 20),\n","        (500, 500, 100, 20),\n","    ]\n","\n","    for x, y, w, h in platform_data:\n","        p = Platform(x, y, w, h)\n","        platforms.add(p)\n","        all_sprites.add(p)\n","\n","    # Create coins\n","    coin_positions = [\n","        (250, 400), (450, 300), (650, 200),\n","        (150, 100), (550, 450), (300, 500)\n","    ]\n","\n","    for x, y in coin_positions:\n","        c = Coin(x, y)\n","        coins.add(c)\n","        all_sprites.add(c)\n","\n","    # Create enemies\n","    enemy_data = [\n","        (250, 425, 80),\n","        (450, 325, 80),\n","    ]\n","\n","    for x, y, r in enemy_data:\n","        e = Enemy(x, y, r)\n","        enemies.add(e)\n","        all_sprites.add(e)\n","\n","    # Game loop\n","    running = True\n","    font = pygame.font.Font(None, 36)\n","\n","    while running:\n","        clock.tick(FPS)\n","\n","        for event in pygame.event.get():\n","            if event.type == pygame.QUIT:\n","                running = False\n","\n","        # Update\n","        player.update(platforms)\n","        enemies.update()\n","\n","        # Check coin collection\n","        collected_coins = pygame.sprite.spritecollide(player, coins, True)\n","        player.score += len(collected_coins)\n","\n","        # Check enemy collision\n","        if pygame.sprite.spritecollide(player, enemies, False):\n","            player.lives -= 1\n","            player.rect.x = 100\n","            player.rect.y = 200\n","            player.vel_y = 0\n","\n","        # Check game over\n","        if player.lives <= 0:\n","            running = False\n","\n","        # Draw\n","        screen.fill(BLUE)\n","        all_sprites.draw(screen)\n","\n","        # Draw UI\n","        score_text = font.render(f\"Score: {player.score}\", True, WHITE)\n","        lives_text = font.render(f\"Lives: {player.lives}\", True, WHITE)\n","        screen.blit(score_text, (10, 10))\n","        screen.blit(lives_text, (10, 50))\n","\n","        pygame.display.flip()\n","\n","    # Game over screen\n","    screen.fill(BLACK)\n","    game_over_text = font.render(\"GAME OVER\", True, RED)\n","    final_score_text = font.render(f\"Final Score: {player.score}\", True, WHITE)\n","    screen.blit(game_over_text, (WIDTH // 2 - 100, HEIGHT // 2 - 50))\n","    screen.blit(final_score_text, (WIDTH // 2 - 120, HEIGHT // 2))\n","    pygame.display.flip()\n","    pygame.time.wait(3000)\n","\n","    pygame.quit()\n","    sys.exit()\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"id":"E-qlTe4pVH8d"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import math\n","import random\n","import pygame\n","\n","# Constants\n","SCREEN_WIDTH = 800\n","SCREEN_HEIGHT = 500\n","PLAYER_START_X = 370\n","PLAYER_START_Y = 380\n","ENEMY_START_Y_MIN = 50\n","ENEMY_START_Y_MAX = 150\n","ENEMY_SPEED_X = 4\n","ENEMY_SPEED_Y = 40\n","BULLET_SPEED_Y = 10\n","COLLISION_DISTANCE = 27\n","\n","# Initialize Pygame\n","pygame.init()\n","\n","# Create the screen\n","screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))\n","\n","# Background\n","background = pygame.image.load('background.png')\n","\n","# Caption and Icon\n","pygame.display.set_caption(\"Space Invader\")\n","icon = pygame.image.load('ufo.png')\n","pygame.display.set_icon(icon)\n","\n","# Player\n","playerImg = pygame.image.load('player.png')\n","playerX = PLAYER_START_X\n","playerY = PLAYER_START_Y\n","playerX_change = 0\n","\n","# Enemy\n","enemyImg = []\n","enemyX = []\n","enemyY = []\n","enemyX_change = []\n","enemyY_change = []\n","num_of_enemies = 6\n","\n","for _i in range(num_of_enemies):\n","    enemyImg.append(pygame.image.load('enemy.png'))\n","    enemyX.append(random.randint(0, SCREEN_WIDTH - 64))  # 64 is the size of the enemy\n","    enemyY.append(random.randint(ENEMY_START_Y_MIN, ENEMY_START_Y_MAX))\n","    enemyX_change.append(ENEMY_SPEED_X)\n","    enemyY_change.append(ENEMY_SPEED_Y)\n","\n","# Bullet\n","bulletImg = pygame.image.load('bullet.png')\n","bulletX = 0\n","bulletY = PLAYER_START_Y\n","bulletX_change = 0\n","bulletY_change = BULLET_SPEED_Y\n","bullet_state = \"ready\"\n","\n","# Score\n","score_value = 0\n","font = pygame.font.Font('freesansbold.ttf', 32)\n","textX = 10\n","textY = 10\n","\n","# Game Over Text\n","over_font = pygame.font.Font('freesansbold.ttf', 64)\n","\n","def show_score(x, y):\n","    # Display the current score on the screen.\n","    score = font.render(\"Score : \" + str(score_value), True, (255, 255, 255))\n","    screen.blit(score, (x, y))\n","\n","def game_over_text():\n","    # Display the game over text\n","    over_text = over_font.render(\"GAME OVER\", True, (255, 255, 255))\n","    screen.blit(over_text, (200, 250))\n","\n","def player(x, y):\n","    # Draw the player on the screen\n","    screen.blit(playerImg, (x, y))\n","\n","def enemy(x, y, i):\n","    # Draw an enemy on the screen\n","    screen.blit(enemyImg[i], (x, y))\n","\n","def fire_bullet(x, y):\n","    # Fire a bullet from the player's position\n","    global bullet_state\n","    bullet_state = \"fire\"\n","    screen.blit(bulletImg, (x + 16, y + 10))\n","\n","def isCollision(enemyX, enemyY, bulletX, bulletY):\n","    # Check if there is a collision between the enemy and a bullet\n","    distance = math.sqrt((enemyX - bulletX) ** 2 + (enemyY - bulletY) ** 2)\n","    return distance < COLLISION_DISTANCE\n","\n","#Game loop\n","running = True\n","while running:\n","    screen.fill((0, 0, 0))\n","    screen.blit(background, (0, 0))\n","\n","    for event in pygame.event.get():\n","      if event.type == pygame.QUIT:\n","          running = False\n","      if event.type == pygame.KEYDOWN:\n","          if event.key == pygame.K_LEFT:\n","              playerX_change = -5\n","          if event.key == pygame.K_RIGHT:\n","              playerX_change = 5\n","          if event.key == pygame.K_SPACE and bullet_state == \"ready\":\n","              bulletX = playerX\n","              fire_bullet(bulletX, bulletY)\n","      if event.type == pygame.KEYUP and event.key in [pygame.K_LEFT, pygame.K_RIGHT]:\n","          playerX_change = 0\n","\n","    # Player Movement\n","    playerX += playerX_change\n","    playerX = max(0, min(playerX, SCREEN_WIDTH - 64))  # 64 is the size of the player\n","\n","    # Enemy Movement\n","    for i in range(num_of_enemies):\n","        if enemyY[i] > 340:  # Game Over Condition\n","            for j in range(num_of_enemies):\n","                enemyY[j] = 2000\n","            game_over_text()\n","            break\n","\n","        enemyX[i] += enemyX_change[i]\n","        if enemyX[i] <= 0 or enemyX[i] >= SCREEN_WIDTH - 64:\n","            enemyX_change[i] *= -1\n","            enemyY[i] += enemyY_change[i]\n","\n","        # Collision Check\n","        if isCollision(enemyX[i], enemyY[i], bulletX, bulletY):\n","            bulletY = PLAYER_START_Y\n","            bullet_state = \"ready\"\n","            score_value += 1\n","            enemyX[i] = random.randint(0, SCREEN_WIDTH - 64)\n","            enemyY[i] = random.randint(ENEMY_START_Y_MIN, ENEMY_START_Y_MAX)\n","\n","        enemy(enemyX[i], enemyY[i], i)\n","\n","    # Bullet Movement\n","    if bulletY <= 0:\n","        bulletY = PLAYER_START_Y\n","        bullet_state = \"ready\"\n","    elif bullet_state == \"fire\":\n","        fire_bullet(bulletX, bulletY)\n","        bulletY -= bulletY_change\n","\n","    player(playerX, playerY)\n","    show_score(textX, textY)\n","    pygame.display.update()"],"metadata":{"id":"zL4GQRW1SRFe"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import pygame\n","import random\n","\n","pygame.init()\n","\n","# Screen\n","SCREEN_WIDTH = 900\n","SCREEN_HEIGHT = 500\n","screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))\n","pygame.display.set_caption(\"Mario Style Platform Game\")\n","\n","# Clock\n","clock = pygame.time.Clock()\n","FPS = 60\n","\n","# Load images\n","background_img = pygame.image.load(\"background.png\")\n","player_img = pygame.image.load(\"player.png\")\n","enemy_img = pygame.image.load(\"enemy.png\")\n","ground_img = pygame.image.load(\"ground.png\")\n","block_img = pygame.image.load(\"block.png\")\n","coin_img = pygame.image.load(\"coin.png\")\n","flag_img = pygame.image.load(\"flag.png\")\n","\n","# Resize images\n","background_img = pygame.transform.scale(background_img, (SCREEN_WIDTH, SCREEN_HEIGHT))\n","player_img = pygame.transform.scale(player_img, (45, 55))\n","enemy_img = pygame.transform.scale(enemy_img, (45, 45))\n","ground_img = pygame.transform.scale(ground_img, (70, 40))\n","block_img = pygame.transform.scale(block_img, (60, 40))\n","coin_img = pygame.transform.scale(coin_img, (30, 30))\n","flag_img = pygame.transform.scale(flag_img, (60, 90))\n","\n","# Player\n","player_rect = pygame.Rect(80, 350, 45, 55)\n","player_speed = 5\n","jump_power = 15\n","gravity = 0.8\n","velocity_y = 0\n","is_jumping = False\n","\n","# Score\n","score = 0\n","font = pygame.font.Font(\"freesansbold.ttf\", 28)\n","\n","# Camera\n","scroll_x = 0\n","\n","# Platforms\n","platforms = [\n","    pygame.Rect(0, 450, 1200, 40),\n","    pygame.Rect(220, 360, 180, 40),\n","    pygame.Rect(500, 310, 160, 40),\n","    pygame.Rect(780, 370, 180, 40),\n","    pygame.Rect(1050, 320, 160, 40),\n","]\n","\n","# Coins\n","coins = [\n","    pygame.Rect(260, 320, 30, 30),\n","    pygame.Rect(550, 270, 30, 30),\n","    pygame.Rect(830, 330, 30, 30),\n","    pygame.Rect(1100, 280, 30, 30),\n","]\n","\n","# Enemies\n","enemies = [\n","    {\"rect\": pygame.Rect(430, 405, 45, 45), \"speed\": 2},\n","    {\"rect\": pygame.Rect(900, 325, 45, 45), \"speed\": 2},\n","]\n","\n","# Flag / Finish\n","flag_rect = pygame.Rect(1250, 360, 60, 90)\n","\n","game_over = False\n","game_win = False\n","\n","\n","def draw_score():\n","    text = font.render(f\"Score: {score}\", True, (255, 255, 255))\n","    screen.blit(text, (20, 20))\n","\n","\n","def reset_game():\n","    global player_rect, velocity_y, score, scroll_x, game_over, game_win, coins\n","\n","    player_rect.x = 80\n","    player_rect.y = 350\n","    velocity_y = 0\n","    score = 0\n","    scroll_x = 0\n","    game_over = False\n","    game_win = False\n","\n","    coins = [\n","        pygame.Rect(260, 320, 30, 30),\n","        pygame.Rect(550, 270, 30, 30),\n","        pygame.Rect(830, 330, 30, 30),\n","        pygame.Rect(1100, 280, 30, 30),\n","    ]\n","\n","\n","running = True\n","\n","while running:\n","    clock.tick(FPS)\n","    screen.blit(background_img, (0, 0))\n","\n","    for event in pygame.event.get():\n","        if event.type == pygame.QUIT:\n","            running = False\n","\n","        if event.type == pygame.KEYDOWN:\n","            if event.key == pygame.K_r:\n","                reset_game()\n","\n","    keys = pygame.key.get_pressed()\n","\n","    if not game_over and not game_win:\n","        # Horizontal movement\n","        dx = 0\n","        if keys[pygame.K_LEFT]:\n","            dx = -player_speed\n","        if keys[pygame.K_RIGHT]:\n","            dx = player_speed\n","\n","        player_rect.x += dx\n","\n","        # Jump\n","        if keys[pygame.K_SPACE] and not is_jumping:\n","            velocity_y = -jump_power\n","            is_jumping = True\n","\n","        # Gravity\n","        velocity_y += gravity\n","        player_rect.y += velocity_y\n","\n","        # Platform collision\n","        is_jumping = True\n","        for platform in platforms:\n","            if player_rect.colliderect(platform):\n","                if velocity_y > 0:\n","                    player_rect.bottom = platform.top\n","                    velocity_y = 0\n","                    is_jumping = False\n","\n","        # Scroll camera\n","        if player_rect.x > 400:\n","            scroll_x += player_rect.x - 400\n","            player_rect.x = 400\n","\n","        # Coin collection\n","        for coin in coins[:]:\n","            coin_screen_rect = pygame.Rect(coin.x - scroll_x, coin.y, coin.width, coin.height)\n","            if player_rect.colliderect(coin_screen_rect):\n","                coins.remove(coin)\n","                score += 1\n","\n","        # Enemy movement and collision\n","        for enemy in enemies:\n","            enemy[\"rect\"].x += enemy[\"speed\"]\n","\n","            if enemy[\"rect\"].x < 350 or enemy[\"rect\"].x > 1000:\n","                enemy[\"speed\"] *= -1\n","\n","            enemy_screen_rect = pygame.Rect(\n","                enemy[\"rect\"].x - scroll_x,\n","                enemy[\"rect\"].y,\n","                enemy[\"rect\"].width,\n","                enemy[\"rect\"].height\n","            )\n","\n","            if player_rect.colliderect(enemy_screen_rect):\n","                game_over = True\n","\n","        # Win condition\n","        flag_screen_rect = pygame.Rect(flag_rect.x - scroll_x, flag_rect.y, flag_rect.width, flag_rect.height)\n","        if player_rect.colliderect(flag_screen_rect):\n","            game_win = True\n","\n","        # Fall condition\n","        if player_rect.y > SCREEN_HEIGHT:\n","            game_over = True\n","\n","    # Draw platforms\n","    for platform in platforms:\n","        for x in range(platform.x, platform.x + platform.width, 70):\n","            screen.blit(ground_img, (x - scroll_x, platform.y))\n","\n","    # Draw coins\n","    for coin in coins:\n","        screen.blit(coin_img, (coin.x - scroll_x, coin.y))\n","\n","    # Draw enemies\n","    for enemy in enemies:\n","        screen.blit(enemy_img, (enemy[\"rect\"].x - scroll_x, enemy[\"rect\"].y))\n","\n","    # Draw flag\n","    screen.blit(flag_img, (flag_rect.x - scroll_x, flag_rect.y))\n","\n","    # Draw player\n","    screen.blit(player_img, (player_rect.x, player_rect.y))\n","\n","    draw_score()\n","\n","    if game_over:\n","        text = font.render(\"GAME OVER! Press R to Restart\", True, (255, 255, 255))\n","        screen.blit(text, (230, 220))\n","\n","    if game_win:\n","        text = font.render(\"YOU WIN! Press R to Restart\", True, (255, 255, 255))\n","        screen.blit(text, (250, 220))\n","\n","    pygame.display.update()\n","\n","pygame.quit()"],"metadata":{"id":"SILK6cZzVGl-"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"e0308759"},"source":["```python\n","import pygame  # Import the Pygame library for game development functionalities.\n","import random  # Import the random module for generating random numbers (though not explicitly used for random generation in this specific code).\n","\n","pygame.init()  # Initialize all the Pygame modules necessary for game creation.\n","\n","# Screen settings\n","SCREEN_WIDTH = 900  # Define the width of the game window in pixels.\n","SCREEN_HEIGHT = 500  # Define the height of the game window in pixels.\n","screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))  # Create the game display surface with the specified dimensions.\n","pygame.display.set_caption(\"Mario Style Platform Game\")  # Set the title of the game window.\n","\n","# Clock and Frame Rate\n","clock = pygame.time.Clock()  # Create a Clock object to help manage the game's frame rate.\n","FPS = 60  # Define the target frames per second for the game.\n","\n","# Load game images\n","background_img = pygame.image.load(\"background.png\")  # Load the background image from a file.\n","player_img = pygame.image.load(\"player.png\")  # Load the player character image.\n","enemy_img = pygame.image.load(\"enemy.png\")  # Load the enemy character image.\n","ground_img = pygame.image.load(\"ground.png\")  # Load the ground/platform image.\n","block_img = pygame.image.load(\"block.png\")  # Load a block image (though not used in the current draw loop).\n","coin_img = pygame.image.load(\"coin.png\")  # Load the coin image.\n","flag_img = pygame.image.load(\"flag.png\")  # Load the finish flag image.\n","\n","# Resize images to fit the game's aesthetic and scale\n","background_img = pygame.transform.scale(background_img, (SCREEN_WIDTH, SCREEN_HEIGHT))  # Scale background to screen size.\n","player_img = pygame.transform.scale(player_img, (45, 55))  # Scale player image to 45x55 pixels.\n","enemy_img = pygame.transform.scale(enemy_img, (45, 45))  # Scale enemy image to 45x45 pixels.\n","ground_img = pygame.transform.scale(ground_img, (70, 40))  # Scale ground image to 70x40 pixels.\n","block_img = pygame.transform.scale(block_img, (60, 40))  # Scale block image (not used).\n","coin_img = pygame.transform.scale(coin_img, (30, 30))  # Scale coin image to 30x30 pixels.\n","flag_img = pygame.transform.scale(flag_img, (60, 90))  # Scale flag image to 60x90 pixels.\n","\n","# Player initial state and physics variables\n","player_rect = pygame.Rect(80, 350, 45, 55)  # Create a rectangle for the player, defining its position and size.\n","player_speed = 5  # Define the horizontal movement speed of the player.\n","jump_power = 15  # Define the initial upward velocity when jumping.\n","gravity = 0.8  # Define the gravitational acceleration acting on the player.\n","velocity_y = 0  # Current vertical velocity of the player.\n","is_jumping = False  # Boolean flag to track if the player is currently jumping.\n","\n","# Score and Font\n","score = 0  # Initialize the player's score.\n","font = pygame.font.Font(\"freesansbold.ttf\", 28)  # Load a font for displaying text (e.g., score).\n","\n","# Camera/Scrolling\n","scroll_x = 0  # Current horizontal scroll offset for the game world.\n","\n","# Game World Elements: Platforms\n","platforms = [  # List of pygame.Rect objects defining the platforms in the game.\n","    pygame.Rect(0, 450, 1200, 40),  # Ground platform extending across a large width.\n","    pygame.Rect(220, 360, 180, 40),  # A higher platform.\n","    pygame.Rect(500, 310, 160, 40),  # Another platform.\n","    pygame.Rect(780, 370, 180, 40),  # Yet another platform.\n","    pygame.Rect(1050, 320, 160, 40),  # Final platform.\n","]\n","\n","# Game World Elements: Coins\n","coins = [  # List of pygame.Rect objects defining the collectible coins.\n","    pygame.Rect(260, 320, 30, 30),  # Coin 1 position and size.\n","    pygame.Rect(550, 270, 30, 30),  # Coin 2 position and size.\n","    pygame.Rect(830, 330, 30, 30),  # Coin 3 position and size.\n","    pygame.Rect(1100, 280, 30, 30),  # Coin 4 position and size.\n","]\n","\n","# Game World Elements: Enemies\n","enemies = [  # List of dictionaries, each defining an enemy's properties.\n","    {\"rect\": pygame.Rect(430, 405, 45, 45), \"speed\": 2},  # Enemy 1: rectangle, and movement speed.\n","    {\"rect\": pygame.Rect(900, 325, 45, 45), \"speed\": 2},  # Enemy 2: rectangle, and movement speed.\n","]\n","\n","# Game World Elements: Flag (Finish Line)\n","flag_rect = pygame.Rect(1250, 360, 60, 90)  # Rectangle defining the finish flag's position and size.\n","\n","game_over = False  # Boolean flag to indicate if the game has ended in a loss.\n","game_win = False  # Boolean flag to indicate if the game has ended in a win.\n","\n","\n","def draw_score():\n","    # Function to render and display the current score on the screen.\n","    text = font.render(f\"Score: {score}\", True, (255, 255, 255))  # Render the score text in white.\n","    screen.blit(text, (20, 20))  # Draw the score text at the top-left corner of the screen.\n","\n","\n","def reset_game():\n","    # Function to reset the game state to its initial conditions.\n","    global player_rect, velocity_y, score, scroll_x, game_over, game_win, coins  # Declare global variables to be modified.\n","\n","    player_rect.x = 80  # Reset player's x-position.\n","    player_rect.y = 350  # Reset player's y-position.\n","    velocity_y = 0  # Reset player's vertical velocity.\n","    score = 0  # Reset score.\n","    scroll_x = 0  # Reset camera scroll.\n","    game_over = False  # Reset game over flag.\n","    game_win = False  # Reset game win flag.\n","\n","    # Reinitialize coins to their original positions (as they are removed when collected).\n","    coins = [\n","        pygame.Rect(260, 320, 30, 30),\n","        pygame.Rect(550, 270, 30, 30),\n","        pygame.Rect(830, 330, 30, 30),\n","        pygame.Rect(1100, 280, 30, 30),\n","    ]\n","\n","\n","running = True  # Main game loop control variable.\n","\n","while running:  # The main game loop.\n","    clock.tick(FPS)  # Limit the game to the defined FPS.\n","    screen.blit(background_img, (0, 0))  # Draw the background image at the top-left of the screen.\n","\n","    for event in pygame.event.get():  # Process all events in the event queue.\n","        if event.type == pygame.QUIT:  # If the user clicks the close button.\n","            running = False  # Set running to False to exit the game loop.\n","\n","        if event.type == pygame.KEYDOWN:  # If a key is pressed down.\n","            if event.key == pygame.K_r:  # If the 'R' key is pressed.\n","                reset_game()  # Call the reset_game function.\n","\n","    keys = pygame.key.get_pressed()  # Get the state of all keyboard keys (True if pressed, False otherwise).\n","\n","    if not game_over and not game_win:  # Only process game logic if the game is ongoing (not over or won).\n","        # Player Horizontal Movement\n","        dx = 0  # Initialize horizontal displacement to 0.\n","        if keys[pygame.K_LEFT]:  # If the left arrow key is pressed.\n","            dx = -player_speed  # Move player to the left.\n","        if keys[pygame.K_RIGHT]:  # If the right arrow key is pressed.\n","            dx = player_speed  # Move player to the right.\n","\n","        player_rect.x += dx  # Apply horizontal movement to the player's rectangle.\n","\n","        # Player Jump\n","        if keys[pygame.K_SPACE] and not is_jumping:  # If spacebar is pressed and player is not already jumping.\n","            velocity_y = -jump_power  # Apply upward velocity for jump.\n","            is_jumping = True  # Set jumping flag to True.\n","\n","        # Apply Gravity\n","        velocity_y += gravity  # Increase vertical velocity due to gravity.\n","        player_rect.y += velocity_y  # Apply vertical movement to the player's rectangle.\n","\n","        # Platform Collision Detection (Vertical)\n","        is_jumping = True  # Assume player is jumping until proven otherwise by collision.\n","        for platform in platforms:  # Iterate through all platforms.\n","            if player_rect.colliderect(platform):  # If player collides with a platform.\n","                if velocity_y > 0:  # If player is moving downwards.\n","                    player_rect.bottom = platform.top  # Snap player to the top of the platform.\n","                    velocity_y = 0  # Stop vertical movement.\n","                    is_jumping = False  # Player is no longer jumping.\n","\n","        # Camera Scrolling Logic\n","        if player_rect.x > 400:  # If player moves past the middle of the screen (e.g., 400 pixels).\n","            scroll_x += player_rect.x - 400  # Adjust the scroll offset.\n","            player_rect.x = 400  # Keep the player's screen x-position fixed to simulate camera movement.\n","\n","        # Coin Collection Logic\n","        for coin in coins[:]:  # Iterate through a copy of the coins list to allow safe removal.\n","            # Create a 'screen-relative' rectangle for the coin, considering the scroll.\n","            coin_screen_rect = pygame.Rect(coin.x - scroll_x, coin.y, coin.width, coin.height)\n","            if player_rect.colliderect(coin_screen_rect):  # If player collides with a coin.\n","                coins.remove(coin)  # Remove the collected coin.\n","                score += 1  # Increment the score.\n","\n","        # Enemy Movement and Collision Logic\n","        for enemy in enemies:  # Iterate through all enemies.\n","            enemy[\"rect\"].x += enemy[\"speed\"]  # Move enemy horizontally based on its speed.\n","\n","            # Reverse enemy direction if it hits certain boundaries (simple patrol).\n","            if enemy[\"rect\"].x < 350 or enemy[\"rect\"].x > 1000:\n","                enemy[\"speed\"] *= -1  # Reverse speed to change direction.\n","\n","            # Create a 'screen-relative' rectangle for the enemy, considering the scroll.\n","            enemy_screen_rect = pygame.Rect(\n","                enemy[\"rect\"].x - scroll_x,\n","                enemy[\"rect\"].y,\n","                enemy[\"rect\"].width,\n","                enemy[\"rect\"].height\n","            )\n","\n","            if player_rect.colliderect(enemy_screen_rect):  # If player collides with an enemy.\n","                game_over = True  # Set game_over flag to True.\n","\n","        # Win Condition Logic\n","        # Create a 'screen-relative' rectangle for the flag, considering the scroll.\n","        flag_screen_rect = pygame.Rect(flag_rect.x - scroll_x, flag_rect.y, flag_rect.width, flag_rect.height)\n","        if player_rect.colliderect(flag_screen_rect):  # If player reaches the flag.\n","            game_win = True  # Set game_win flag to True.\n","\n","        # Fall Condition (Player falls off the bottom of the screen)\n","        if player_rect.y > SCREEN_HEIGHT:  # If player's y-position is below the screen height.\n","            game_over = True  # Set game_over flag to True.\n","\n","    # Drawing game elements\n","    # Draw Platforms\n","    for platform in platforms:  # Iterate through all platforms.\n","        # Draw multiple ground images to fill the platform rectangle, considering scroll.\n","        for x in range(platform.x, platform.x + platform.width, 70):\n","            screen.blit(ground_img, (x - scroll_x, platform.y))\n","\n","    # Draw Coins\n","    for coin in coins:  # Iterate through remaining coins.\n","        screen.blit(coin_img, (coin.x - scroll_x, coin.y))  # Draw coin, adjusted by scroll.\n","\n","    # Draw Enemies\n","    for enemy in enemies:  # Iterate through enemies.\n","        screen.blit(enemy_img, (enemy[\"rect\"].x - scroll_x, enemy[\"rect\"].y))  # Draw enemy, adjusted by scroll.\n","\n","    # Draw Flag\n","    screen.blit(flag_img, (flag_rect.x - scroll_x, flag_rect.y))  # Draw flag, adjusted by scroll.\n","\n","    # Draw Player\n","    screen.blit(player_img, (player_rect.x, player_rect.y))  # Draw player at its screen position.\n","\n","    draw_score()  # Call function to draw the current score.\n","\n","    # Display Game Over or You Win messages\n","    if game_over:  # If game is over.\n","        text = font.render(\"GAME OVER! Press R to Restart\", True, (255, 255, 255))  # Render game over message.\n","        screen.blit(text, (230, 220))  # Draw message in the center of the screen.\n","\n","    if game_win:  # If game is won.\n","        text = font.render(\"YOU WIN! Press R to Restart\", True, (255, 255, 255))  # Render win message.\n","        screen.blit(text, (250, 220))  # Draw message in the center of the screen.\n","\n","    pygame.display.update()  # Update the entire screen to show all drawn elements.\n","\n","pygame.quit()  # Uninitialize Pygame modules and exit the game.\n","```"]},{"cell_type":"markdown","source":["Left Arrow = Move Left\n","\n","Right Arrow = Move Right\n","\n","Space = Jump\n","\n","R = Restart"],"metadata":{"id":"iGCG-TDlVsE_"}},{"cell_type":"markdown","source":["background.png\n","player.png\n","enemy.png\n","ground.png\n","block.png\n","coin.png\n","flag.png"],"metadata":{"id":"abrGqOfYVyK0"}}]}