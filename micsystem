{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1PdBf8Rx8PUbOAfuRUeRsRaU4BXOtDeT2","timestamp":1782558202268}]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"IsJ-nWXwq-nY"},"outputs":[],"source":["import os\n","import random\n","import time\n","import speech_recognition as sr\n","import pygame\n","\n","class AIMusicAssistant:\n","    def __init__(self, music_directory):\n","        self.music_dir = music_directory\n","        self.recognizer = sr.Recognizer()\n","\n","        # Initialize Pygame Mixer for background audio playback\n","        pygame.mixer.init()\n","\n","        # Scan folder for supported audio formats\n","        self.playlist = [\n","            f for f in os.listdir(self.music_dir)\n","            if f.endswith('.mp3') # or other formats\n","        ]\n","        self.current_index = 0\n","\n","        print(f\"Loaded {len(self.playlist)} tracks from library.\")\n","\n","    def listen_command(self):\n","        \"\"\"Captures voice from microphone and converts it to text string.\"\"\"\n","        with sr.Microphone() as source:\n","            print(\"\\nListening for music command...\")\n","            # Adjusts background noise threshold dynamically\n","            self.recognizer.adjust_for_ambient_noise(source, duration=0.5)\n","            try:\n","                audio = self.recognizer.listen(source, timeout=5, phrase_time_limit=5)\n","                command = self.recognizer.recognize_google(audio)\n","                print(f\"You said: {command}\")\n","                return command.lower()\n","            except (sr.UnknownValueError, sr.WaitTimeoutError):\n","                return \"\"\n","            except sr.RequestError:\n","                print(\"API unavailable.\")\n","                return \"\"\n","\n","    def execute_music_logic(self, command):\n","        \"\"\"Parses intent keywords and maps them to player actions.\"\"\"\n","        if not command:\n","            return True\n","\n","        # Action: Play / Resume\n","        if \"play\" in command or \"resume\" in command:\n","            if pygame.mixer.music.get_busy() == False and pygame.mixer.music.get_pos() > -1:\n","                pygame.mixer.music.unpause()\n","                print(\"Resuming playback.\")\n","            else:\n","                # Check if specific song name requested, else play current track\n","                self.play_track()\n","\n","        # Action: Pause\n","        elif \"pause\" in command or \"hold\" in command:\n","            pygame.mixer.music.pause()\n","            print(\"Music paused.\")\n","\n","        # Action: Stop\n","        elif \"stop\" in command:\n","            pygame.mixer.music.stop()\n","            print(\"Music stopped.\")\n","\n","        # Action: Next Track\n","        elif \"next\" in command or \"skip\" in command:\n","            if self.playlist:\n","                self.current_index = (self.current_index + 1) % len(self.playlist)\n","                self.play_track()\n","\n","        # Action: Shuffle / Random Play\n","        elif \"shuffle\" in command or \"random\" in command:\n","            if self.playlist:\n","                self.current_index = random.randint(0, len(self.playlist) - 1)\n","                self.play_track()\n","\n","        # Action: Exit the Assistant Loop\n","        elif \"exit\" in command or \"quit\" in command:\n","            pygame.mixer.music.stop()\n","            print(\"Goodbye!\")\n","            return False\n","\n","        return True\n","\n","    def play_track(self):\n","        \"\"\"Helper to cleanly load and start an audio file.\"\"\"\n","        if not self.playlist:\n","            print(\"Your music folder is empty.\")\n","            return\n","\n","        track_name = self.playlist[self.current_index]\n","        track_path = os.path.join(self.music_dir, track_name)\n","\n","        try:\n","            pygame.mixer.music.load(track_path)\n","            pygame.mixer.music.play()\n","            print(f\"Now playing: {track_name}\")\n","        except Exception as e:\n","            print(f\"Failed to play track: {e}\")\n","\n","    def run(self):\n","        \"\"\"Main listening runtime loop.\"\"\"\n","        print(\"AI Assistant Music Player Active. Say 'Play', 'Pause', 'Next', 'Shuffle' or 'Exit'.\")\n","        is_running = True\n","        while is_running:\n","            voice_input = self.listen_command()\n","            is_running = self.execute_music_logic(voice_input)\n","            time.sleep(0.2) # Soften CPU processing loops\n","\n","# --- Execution Setup ---\n","if __name__ == \"__main__\":\n","    # Create a dummy or real local pathway populated with sample .mp3 or .wav files\n","    PATH_TO_MUSIC = \"./my_music\"\n","\n","    if not os.path.exists(PATH_TO_MUSIC):\n","        os.makedirs(PATH_TO_MUSIC)\n","        print(f\"Created '{PATH_TO_MUSIC}' directory. Drop your audio files there before running!\")\n","\n","    # Initialize and boot the assistant agent\n","    assistant = AIMusicAssistant(music_directory=PATH_TO_MUSIC)\n","    assistant.run()\n"]}]}