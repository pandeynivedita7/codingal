mber.\n","print(\"  binary:\", bin(n)[2:])\n","# Ask the user to guess the value of bit 2 for the entered number.\n","guess = input(\"What is bit 2 of \" + str(n) + \"? (0 or 1): \")\n","# Prompt the user to press Enter to reveal the method for bit probing.\n","input(\"Bit probe: (n >> 2) & 1 gives the bit value.  Press Enter \")\n","# Print the actual value of bit 2 for the entered number and compare it with the user's guess.\n","print(\" \", n, \"bit 2 =\", (n >> 2) & 1, \"  your guess:\", guess)"],"metadata":{"id":"qq3Kc3xoiqp4"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 03-bit-diff.py\n","# Topic: Bit Difference\n","\n","# Explain the concept of bit difference: XOR operation helps identify differing bits.\n","input(\"Bit difference - XOR shows which bits differ.  Press Enter \")\n","# Demonstrate with 5 XOR 3:\n","# 5 (binary 101) XOR 3 (binary 011) = 6 (binary 110)\n","# Count the number of '1's in the binary representation of the XOR result to find differing bits.\n","print(\"  5 ^ 3 =\", 5 ^ 3, \"  binary\", bin(5 ^ 3)[2:], \"  bits different:\", bin(5 ^ 3).count('1'))\n","# Demonstrate with 9 XOR 5:\n","# 9 (binary 1001) XOR 5 (binary 0101) = 12 (binary 1100)\n","# Count '1's to find differing bits.\n","print(\"  9 ^ 5 =\", 9 ^ 5, \"  binary\", bin(9 ^ 5)[2:], \"  bits different:\", bin(9 ^ 5).count('1'))\n","\n","# Ask the user to enter a number (suggesting 4 or 6).\n","n = int(input(\"Enter a number (try 4 or 6): \"))\n","# Ask the user to guess how many bits differ between the entered number and 7.\n","guess = input(\"How many bits differ between \" + str(n) + \" and 7? \")\n","# Prompt the user to press Enter to reveal the method for calculating bit differences.\n","input(\"XOR marks the differing bits - count the 1s.  Press Enter \")\n","# Calculate the bit difference: XOR the number with 7 and count the set bits.\n","diff = bin(n ^ 7).count('1')\n","# Print the binary representation of the XOR result, the actual number of di