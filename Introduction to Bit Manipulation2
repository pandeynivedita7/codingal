{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPhNQBhnQUTrCZWiZRFSut1"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"nQXACQM9qxVs"},"outputs":[],"source":["# PART 6: Count Bits\n","# Defines a function to count the number of bits in a given integer 'n'.\n","def count_bits(n):\n","    # Initialize a counter for the bits to 0.\n","    count = 0\n","    # Loop continues as long as 'n' is not zero. Each iteration processes one bit.\n","    while n:\n","        # Increment the count for each bit found.\n","        count += 1\n","        # Right-shift 'n' by 1 bit. This effectively divides 'n' by 2 and discards the least significant bit.\n","        # The loop terminates when all bits have been shifted out and 'n' becomes 0.\n","        n >>= 1\n","    # Return the total count of bits.\n","    return count\n","\n","# This part of the code demonstrates the usage of the count_bits function.\n","# It iterates through a list of numbers (assuming 'a' and 'b' are defined elsewhere).\n","# For each number, it prints the number, its bit count, and its binary representation (assuming 'bits' function is defined).\n","# The 'bits' function is not provided in this snippet but is assumed to convert a number to its binary string representation.\n","for n in [a, b, 255]:#\n","    print(n, '->', count_bits(n), 'bits |', bits(n, count_bits(n)))\n","\n","# Output:\n","# 10  -> 4 bits | 1010\n","# 6   -> 3 bits | 110\n","# 255 -> 8 bits | 11111111\n","\n","# Trace for n=10:\n","# 1. n = 10 (binary 1010), count = 0\n","# 2. Loop: n is not 0. count = 1. n >>= 1 (n becomes 5, binary 101)\n","# 3. Loop: n is not 0. count = 2. n >>= 1 (n becomes 2, binary 10)\n","# 4. Loop: n is not 0. count = 3. n >>= 1 (n becomes 1, binary 1)\n","# 5. Loop: n is not 0. count = 4. n >>= 1 (n becomes 0, binary 0)\n","# 6. Loop: n is 0. Exit loop.\n","# Result: 4 bits\n","# The trace shows how the right-shift operation counts each '1' or '0' position until the number becomes zero."]}]}