   plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n","        plt.title(title)\n","        plt.axis('off')\n","    plt.tight_layout()\n","    plt.show()\n","\n","def apply_sobel(gray_image):\n","    \"\"\"Apply Sobel edge detection.\"\"\"\n","    sobelx = cv2.Sobel(gray_image, cv2.CV_64F, 1, 0, ksize=3)\n","    sobely = cv2.Sobel(gray_image, cv2.CV_64F, 0, 1, ksize=3)\n","    sobel_combined = np.sqrt(sobelx**2 + sobely**2)\n","    sobel_combined = np.uint8(sobel_combined / sobel_combined.max() * 255)\n","    return sobel_combined\n","\n","def apply_canny(gray_image, low_thresh=50, high_thresh=150):\n","    \"\"\"Apply Canny edge detection.\"\"\"\n","    return cv2.Canny(gray_image, low_thresh, high_thresh)\n","\n","def apply_laplacian(gray_image):\n","    \"\"\"Apply Laplacian edge detection.\"\"\"\n","    laplacian = cv2.Laplacian(gray_image, cv2.CV_64F)\n","    laplacian = np.uint8(np.absolute(laplacian))# abs valur great 0\n","    return laplacian\n","\n","def apply_gaussian_blur(image, kernel_size=5):\n","    \"\"\"Apply Gaussian smoothing.\"\"\"\n","    return cv2.GaussianBlur(image, (kernel_size, kernel_size), 0)\n","\n","def apply_median_filter(image, kernel_size=5):\n","    \"\"\"Apply Median filtering.\"\"\"\n","    return cv2.medianBlur(image, kernel_size)\n","\n","def main():\n","    \"\"\"Main application function.\"\"\"\n","    print(\"=\" * 60)\n","    print(\"EDGE DETECTION & FILTERING APPLICATION\")\n","    print(\"=\" * 60)\n","\n","    # Upload image\n","    print(\"\\n[Step 1] Upload an image...\")\n","    result = upload_image()\n","\n","    if result is None:\n","        print(\"No image uploaded. Exiting...\")\n","        return\n","\n","    image, filename = result\n","    print(f\"✓ Image loaded: {filename}\")\n","\n","    gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n","\n","    while True:\n","        print(\"\\n\" + \"=\" * 60)\n","        print(\"MENU OPTIONS\")\n","        print(\"=\" * 60)\n","        print(\"1. View Original 