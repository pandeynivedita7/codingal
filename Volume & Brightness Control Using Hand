{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyO5lyIUMJeIxnDU4jjJbpoV"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"5iH35gMfcadg"},"outputs":[],"source":["import cv2, mediapipe as mp, numpy as np\n","from pycaw.pycaw import AudioUtilities, IAudioEndpointVolume\n","import screen_brightness_control as sbc\n","\n","Hands = mp.solutions.hands\n","hands = Hands.Hands(min_detection_confidence=0.7, min_tracking_confidence=0.7)\n","draw = mp.solutions.drawing_utils\n","TH, IX = Hands.HandLandmark.THUMB_TIP, Hands.HandLandmark.INDEX_FINGER_TIP\n","\n","try:\n","    dev = AudioUtilities.GetDefaultOutputDevice() if hasattr(AudioUtilities, \"GetDefaultOutputDevice\") else AudioUtilities.GetSpeakers()\n","    volctl = dev.EndpointVolume.QueryInterface(IAudioEndpointVolume)\n","    minv, maxv = volctl.GetVolumeRange()[:2]\n","except Exception as e:\n","    print(f\"Pycaw error: {e}\"); exit()\n","\n","cap = cv2.VideoCapture(0)\n","if not cap.isOpened(): print(\"Error: Webcam not accessible.\"); exit()\n","\n","WIN = \"Hand Gesture Control\"; cv2.namedWindow(WIN, cv2.WINDOW_NORMAL)\n","\n","while True:\n","    ok, img = cap.read()\n","    if not ok: break\n","    img = cv2.flip(img, 1); h, w = img.shape[:2]\n","    res = hands.process(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n","\n","    if res.multi_hand_landmarks and res.multi_handedness:\n","        for i, hand in enumerate(res.multi_hand_landmarks):\n","            label = res.multi_handedness[i].classification[0].label\n","            draw.draw_landmarks(img, hand, Hands.HAND_CONNECTIONS)\n","            lm = hand.landmark\n","            tp = (int(lm[TH].x*w), int(lm[TH].y*h)); ip = (int(lm[IX].x*w), int(lm[IX].y*h))\n","            cv2.circle(img, tp, 10, (255,0,0), cv2.FILLED); cv2.circle(img, ip, 10, (255,0,0), cv2.FILLED)\n","            cv2.line(img, tp, ip, (0,255,0), 3)\n","            dist = float(np.hypot(ip[0]-tp[0], ip[1]-tp[1]))\n","\n","            if label == \"Left\":  # real RIGHT hand -> volume (frame is flipped)\n","                v = np.interp(dist, [30,300], [minv,maxv])\n","                try: volctl.SetMasterVolumeLevel(v, None)\n","                except Exception as e: print(f\"Volume error: {e}\")\n","                bar = int(np.interp(dist, [30,300], [400,150])); pct = int(np.interp(dist, [30,300], [0,100]))\n","                cv2.rectangle(img, (50,150), (85,400), (255,0,0), 2); cv2.rectangle(img, (50,bar), (85,400), (255,0,0), cv2.FILLED)\n","                cv2.putText(img, f\"{pct}%\", (40,450), cv2.FONT_HERSHEY_SIMPLEX, 1, (255,0,0), 3)\n","\n","            elif label == \"Right\":  # real LEFT hand -> brightness\n","                b = int(np.interp(dist, [30,300], [0,100]))\n","                try: sbc.set_brightness(b)\n","                except Exception as e: print(f\"Brightness error: {e}\")\n","                bar = int(np.interp(dist, [30,300], [400,150])); x1, x2 = w-85, w-50\n","                cv2.rectangle(img, (x1,150), (x2,400), (0,255,0), 2); cv2.rectangle(img, (x1,bar), (x2,400), (0,255,0), cv2.FILLED)\n","                cv2.putText(img, f\"{b}%\", (w-110,450), cv2.FONT_HERSHEY_SIMPLEX, 1, (0,255,0), 3)\n","\n","    cv2.imshow(WIN, img)\n","    k = cv2.waitKey(1) & 0xFF\n","    if k in (27, ord(\"q\")): break\n","    try:\n","        if cv2.getWindowProperty(WIN, cv2.WND_PROP_VISIBLE) < 1: break\n","    except cv2.error:\n","        break\n","\n","cap.release(); cv2.destroyAllWindows()"]},{"cell_type":"code","source":["import cv2\n","\n","cap = cv2.VideoCapture(0)\n","\n","if not cap.isOpened():\n","    print(\"Camera could not be opened\")\n","    exit()\n","\n","print(\"Camera opened successfully\")\n","\n","while True:\n","    ret, frame = cap.read()\n","\n","    if not ret:\n","        print(\"Could not read frame\")\n","        break\n","\n","    cv2.imshow(\"Camera Test\", frame)\n","\n","    if cv2.waitKey(1) & 0xFF == ord(\"q\"):\n","        break\n","\n","cap.release()\n","cv2.destroyAllWindows()"],"metadata":{"id":"IXySEQAsfYly"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import cv2 # Import OpenCV library for computer vision tasks\n","import mediapipe as mp # Import MediaPipe library for hand detection and landmark estimation\n","import numpy as np # Import NumPy for numerical operations\n","import subprocess # Import subprocess module to run external commands (e.g., AppleScript for volume control, 'brightness' command)\n","import time # Import time module for delays\n","\n","# ----------------------------- # Section for MediaPipe setup\n","# MediaPipe setup\n","# -----------------------------\n","Hands = mp.solutions.hands # Access the hands solution from MediaPipe\n","\n","hands = Hands.Hands( # Initialize the Hands object for hand tracking\n","    min_detection_confidence=0.7, # Set minimum confidence threshold for hand detection\n","    min_tracking_confidence=0.7 # Set minimum confidence threshold for hand tracking\n",")\n","\n","draw = mp.solutions.drawing_utils # Access the drawing utility from MediaPipe to draw landmarks and connections\n","\n","TH = Hands.HandLandmark.THUMB_TIP # Define a constant for the Thumb Tip landmark\n","IX = Hands.HandLandmark.INDEX_FINGER_TIP # Define a constant for the Index Finger Tip landmark\n","\n","\n","# ----------------------------- # Section for macOS volume control\n","# macOS volume control\n","# -----------------------------\n","def set_volume(volume): # Define a function to set the system volume\n","    volume = int(max(0, min(100, volume))) # Clamp the volume value between 0 and 100\n","\n","    subprocess.run( # Execute an AppleScript command to set the output volume\n","        [\n","            \"osascript\", # AppleScript interpreter\n","            \"-e\", # Execute command\n","            f\"set volume output volume {volume}\" # AppleScript command for macOS volume control\n","        ],\n","        stdout=subprocess.DEVNULL, # Redirect standard output to /dev/null\n","        stderr=subprocess.DEVNULL # Redirect standard error to /dev/null\n","    )\n","\n","\n","# ----------------------------- # Section for Brightness control\n","# Brightness control\n","# -----------------------------\n","def set_brightness(brightness): # Define a function to set the system brightness\n","    brightness = int(max(1, min(100, brightness))) # Clamp the brightness value between 1 and 100\n","\n","    value = brightness / 100.0 # Convert percentage to a float between 0.01 and 1.0\n","\n","    try:\n","        subprocess.run( # Execute the 'brightness' command (requires installation, e.g., via Homebrew)\n","            [\"brightness\", str(value)], # Command and argument\n","            stdout=subprocess.DEVNULL, # Redirect standard output to /dev/null\n","            stderr=subprocess.DEVNULL # Redirect standard error to /dev/null\n","        )\n","\n","    except FileNotFoundError: # Handle case where 'brightness' command is not found\n","        print(\"Brightness tool not installed.\") # Inform user about missing tool\n","        print(\"Install it using: brew install brightness\") # Provide installation instructions\n","\n","\n","# ----------------------------- # Section for Camera setup\n","# Open camera\n","# -----------------------------\n","print(\"Starting program...\", flush=True) # Print a starting message, flushing output immediately\n","\n","cap = cv2.VideoCapture( # Initialize video capture from the default webcam\n","    0, # Camera index (0 for default webcam)\n","    cv2.CAP_AVFOUNDATION # Specify the AVFoundation backend for macOS\n",")\n","\n","time.sleep(1) # Wait for 1 second to allow camera to initialize\n","\n","if not cap.isOpened(): # Check if the webcam was opened successfully\n","    print(\"Camera could not be opened.\") # Print an error message if webcam is not accessible\n","    print(\"Go to System Settings > Privacy & Security > Camera\") # Suggest a common macOS troubleshooting step\n","    print(\"Allow camera access for Terminal or VS Code.\") # Further suggestion\n","    exit() # Exit the program\n","\n","print(\"Camera opened successfully.\", flush=True) # Confirm camera opened, flushing output immediately\n","\n","\n","# ----------------------------- # Section for Window setup\n","# Window setup\n","# -----------------------------\n","WIN = \"Hand Gesture Control\" # Define the name for the display window\n","\n","cv2.namedWindow( # Create a resizable window with the defined name\n","    WIN,\n","    cv2.WINDOW_NORMAL\n",")\n","\n","cv2.resizeWindow( # Resize the display window to a specific size\n","    WIN,\n","    1000,\n","    700\n",")\n","\n","\n","# ----------------------------- # Main program loop\n","# Main loop\n","# -----------------------------\n","while True: # Start an infinite loop for video processing\n","\n","    ok, img = cap.read() # Read a frame from the webcam. 'ok' is a boolean, 'img' is the frame.\n","\n","    if not ok: # If frame was not read successfully, break the loop\n","        print(\"Could not read camera frame.\") # Print an error message\n","        break # Exit the loop\n","\n","    img = cv2.flip(img, 1) # Flip the image horizontally (1 for horizontal flip), useful for mirror effect\n","\n","    h, w = img.shape[:2] # Get the height and width of the image\n","\n","    rgb = cv2.cvtColor( # Convert the image from BGR (OpenCV default) to RGB (MediaPipe default)\n","        img,\n","        cv2.COLOR_BGR2RGB\n","    )\n","\n","    res = hands.process(rgb) # Process the RGB image to detect hands and landmarks\n","\n","    if res.multi_hand_landmarks and res.multi_handedness: # Check if hand landmarks and handedness were detected\n","\n","        for i, hand in enumerate(res.multi_hand_landmarks): # Iterate through each detected hand\n","\n","            label = ( # Get the label (Left/Right) for the current hand\n","                res.multi_handedness[i]\n","                .classification[0]\n","                .label\n","            )\n","\n","            draw.draw_landmarks( # Draw the hand landmarks and connections on the image\n","                img,\n","                hand,\n","                Hands.HAND_CONNECTIONS\n","            )\n","\n","            lm = hand.landmark # Get the list of landmarks for the current hand\n","\n","            tp = ( # Get the coordinates of the Thumb Tip landmark\n","                int(lm[TH].x * w), # X-coordinate scaled to image width\n","                int(lm[TH].y * h)  # Y-coordinate scaled to image height\n","            )\n","\n","            ip = ( # Get the coordinates of the Index Finger Tip landmark\n","                int(lm[IX].x * w), # X-coordinate scaled to image width\n","                int(lm[IX].y * h)  # Y-coordinate scaled to image height\n","            )\n","\n","            cv2.circle( # Draw a circle at the Thumb Tip\n","                img,\n","                tp,\n","                10,\n","                (255, 0, 0), # Blue color\n","                cv2.FILLED # Fill the circle\n","            )\n","\n","            cv2.circle( # Draw a circle at the Index Finger Tip\n","                img,\n","                ip,\n","                10,\n","                (255, 0, 0), # Blue color\n","                cv2.FILLED # Fill the circle\n","            )\n","\n","            cv2.line( # Draw a line connecting the Thumb Tip and Index Finger Tip\n","                img,\n","                tp,\n","                ip,\n","                (0, 255, 0), # Green color\n","                3 # Line thickness\n","            )\n","\n","            dist = float( # Calculate the Euclidean distance between the Thumb Tip and Index Finger Tip\n","                np.hypot(\n","                    ip[0] - tp[0],\n","                    ip[1] - tp[1]\n","                )\n","            )\n","\n","            dist = np.clip( # Clip the distance to a predefined range to prevent extreme values\n","                dist,\n","                30,\n","                300\n","            )\n","\n","            # ----------------------------- # Logic for Right hand (user's perspective) -> Volume control\n","            # Right hand -> Volume\n","            # -----------------------------\n","            if label == \"Left\": # If the detected hand is MediaPipe's \"Left\" (which corresponds to the user's right hand due to flipping)\n","\n","                volume = int( # Interpolate the distance to a volume percentage (0-100)\n","                    np.interp(\n","                        dist, # Current distance\n","                        [30, 300], # Input distance range (min_dist, max_dist)\n","                        [0, 100] # Output volume range\n","                    )\n","                )\n","\n","                set_volume(volume) # Call the function to set the system volume\n","\n","                bar = int( # Interpolate the volume percentage to a bar height for visual feedback\n","                    np.interp(\n","                        volume, # Current volume percentage\n","                        [0, 100], # Input volume range\n","                        [400, 150] # Output bar height range (reversed so larger volume = lower bar top)\n","                    )\n","                )\n","\n","                cv2.rectangle( # Draw the outer rectangle for the volume bar\n","                    img,\n","                    (50, 150), # Top-left corner of the bar container\n","                    (85, 400), # Bottom-right corner of the bar container\n","                    (255, 0, 0), # Blue color\n","                    2 # Thickness of the rectangle\n","                )\n","\n","                cv2.rectangle( # Draw the filled inner rectangle representing the current volume level\n","                    img,\n","                    (50, bar), # Top-left corner of the filled bar\n","                    (85, 400), # Bottom-right corner of the filled bar\n","                    (255, 0, 0), # Blue color\n","                    cv2.FILLED # Fill the rectangle\n","                )\n","\n","                cv2.putText( # Display the volume percentage on the image\n","                    img,\n","                    f\"Volume {volume}%\", # Text to display\n","                    (30, 450), # Position of the text\n","                    cv2.FONT_HERSHEY_SIMPLEX, # Font type\n","                    0.8, # Font scale\n","                    (255, 0, 0), # Blue color\n","                    2 # Thickness of the text\n","                )\n","\n","            # ----------------------------- # Logic for Left hand (user's perspective) -> Brightness control\n","            # Left hand -> Brightness\n","            # -----------------------------\n","            elif label == \"Right\": # If the detected hand is MediaPipe's \"Right\" (which corresponds to the user's left hand due to flipping)\n","\n","                brightness = int( # Interpolate the distance to a brightness percentage (1-100)\n","                    np.interp(\n","                        dist, # Current distance\n","                        [30, 300], # Input distance range\n","                        [1, 100] # Output brightness range (1-100)\n","                    )\n","                )\n","\n","                set_brightness(brightness) # Call the function to set the system brightness\n","\n","                bar = int( # Interpolate the brightness percentage to a bar height for visual feedback\n","                    np.interp(\n","                        brightness, # Current brightness percentage\n","                        [1, 100], # Input brightness range\n","                        [400, 150] # Output bar height range (reversed)\n","                    )\n","                )\n","\n","                x1 = w - 85 # Calculate x-coordinate for the left side of the brightness bar\n","                x2 = w - 50 # Calculate x-coordinate for the right side of the brightness bar\n","\n","                cv2.rectangle( # Draw the outer rectangle for the brightness bar\n","                    img,\n","                    (x1, 150), # Top-left corner\n","                    (x2, 400), # Bottom-right corner\n","                    (0, 255, 0), # Green color\n","                    2 # Thickness\n","                )\n","\n","                cv2.rectangle( # Draw the filled inner rectangle representing the current brightness level\n","                    img,\n","                    (x1, bar), # Top-left corner of the filled bar\n","                    (x2, 400), # Bottom-right corner of the filled bar\n","                    (0, 255, 0), # Green color\n","                    cv2.FILLED # Fill the rectangle\n","                )\n","\n","                cv2.putText( # Display the brightness percentage on the image\n","                    img,\n","                    f\"Brightness {brightness}%\", # Text to display\n","                    (w - 250, 450), # Position of the text\n","                    cv2.FONT_HERSHEY_SIMPLEX, # Font type\n","                    0.8, # Font scale\n","                    (0, 255, 0), # Green color\n","                    2 # Thickness\n","                )\n","\n","    cv2.putText( # Display instructions for the right hand (volume)\n","        img,\n","        \"Right hand = Volume\",\n","        (20, 40), # Position\n","        cv2.FONT_HERSHEY_SIMPLEX,\n","        0.7,\n","        (255, 255, 255), # White color\n","        2\n","    )\n","\n","    cv2.putText( # Display instructions for the left hand (brightness)\n","        img,\n","        \"Left hand = Brightness\",\n","        (20, 70), # Position\n","        cv2.FONT_HERSHEY_SIMPLEX,\n","        0.7,\n","        (255, 255, 255), # White color\n","        2\n","    )\n","\n","    cv2.putText( # Display instruction to quit\n","        img,\n","        \"Press Q to quit\",\n","        (20, 100), # Position\n","        cv2.FONT_HERSHEY_SIMPLEX,\n","        0.7,\n","        (255, 255, 255), # White color\n","        2\n","    )\n","\n","    cv2.imshow( # Display the processed image in the window\n","        WIN,\n","        img\n","    )\n","\n","    key = cv2.waitKey(1) & 0xFF # Wait for 1 millisecond and get the pressed key\n","\n","    if key == ord(\"q\") or key == 27: # Check if 'q' key (quit) or 'Esc' key (27) was pressed\n","        break # Break the loop to exit the program\n","\n","\n","cap.release() # Release the webcam resource\n","hands.close() # Close the MediaPipe Hands object to release resources\n","cv2.destroyAllWindows() # Destroy all OpenCV windows\n","\n","print(\"Program closed.\") # Print a message indicating the program has closed"],"metadata":{"id":"rJtRFlfpjmru"},"execution_count":null,"outputs":[]}]}