{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMtpgbkRjeyvSBsfbW+v5jC"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"YcPHoPGOGwnf"},"outputs":[],"source":["import cv2 # Import OpenCV library for computer vision tasks (e.g., camera access, image processing)\n","import time # Import time library for time-related functions (e.g., calculating FPS, managing scroll delay)\n","import pyautogui # Import pyautogui for GUI automation (e.g., scrolling)\n","import mediapipe as mp # Import MediaPipe library for hand detection and landmark tracking\n","\n","# Initialize MediaPipe Hands solution\n","mp_hands = mp.solutions.hands\n","# Configure the Hands model: max_num_hands=1 for single hand detection, min_detection_confidence for detection threshold\n","hands = mp_hands.Hands(max_num_hands=1, min_detection_confidence=0.7)\n","# Initialize MediaPipe drawing utilities for visualizing hand landmarks\n","mp_drawing = mp.solutions.drawing_utils\n","\n","# --- Configuration Parameters ---\n","SCROLL_SPEED = 300 # Define the scrolling speed for pyautogui\n","SCROLL_DELAY = 1 # Define the minimum delay between scroll actions to prevent excessive scrolling\n","CAM_WIDTH, CAM_HEIGHT = 640, 480 # Define the desired width and height for the camera feed\n","\n","# Function to detect specific hand gestures based on landmark positions\n","def detect_gesture(landmarks, handedness):\n","    fingers = [] # List to store states of open fingers (1 if open)\n","    # Define the tip landmarks for index, middle, ring, and pinky fingers\n","    tips = [mp_hands.HandLandmark.INDEX_FINGER_TIP, mp_hands.HandLandmark.MIDDLE_FINGER_TIP,\n","            mp_hands.HandLandmark.RING_FINGER_TIP, mp_hands.HandLandmark.PINKY_TIP]\n","\n","    # Check if each finger (except thumb) is extended (tip is above the knuckle)\n","    for tip in tips:\n","        # Compare y-coordinate of tip with the y-coordinate of the metacarpal-phalangeal (MP) joint (tip-2)\n","        if landmarks.landmark[tip].y < landmarks.landmark[tip - 2].y:\n","            fingers.append(1) # If extended, add 1 to fingers list\n","\n","    # Check thumb extension based on handedness\n","    thumb_tip = landmarks.landmark[mp_hands.HandLandmark.THUMB_TIP] # Get thumb tip landmark\n","    thumb_ip = landmarks.landmark[mp_hands.HandLandmark.THUMB_IP] # Get thumb interphalangeal (IP) joint landmark\n","    # For a Right hand, thumb is extended if its tip x-coordinate is greater than IP joint x-coordinate\n","    # For a Left hand, thumb is extended if its tip x-coordinate is less than IP joint x-coordinate\n","    if (handedness == \"Right\" and thumb_tip.x > thumb_ip.x) or (handedness == \"Left\" and thumb_tip.x < thumb_ip.x):\n","        fingers.append(1) # If extended, add 1 to fingers list\n","\n","    # Determine gesture based on the number of extended fingers\n","    # \"scroll_up\" if all 5 fingers (including thumb) are extended (open palm)\n","    # \"scroll_down\" if no fingers are extended (fist)\n","    # \"none\" for any other state\n","    return \"scroll_up\" if sum(fingers) == 5 else \"scroll_down\" if len(fingers) == 0 else \"none\"\n","\n","# Initialize video capture object for the default camera (index 0)\n","cap = cv2.VideoCapture(0)\n","# Set camera feed width\n","cap.set(3, CAM_WIDTH)\n","# Set camera feed height\n","cap.set(4, CAM_HEIGHT)\n","\n","# Initialize variables for scroll delay and FPS calculation\n","last_scroll = p_time = 0\n","\n","# Print instructions to the console\n","print(\"Gesture Scroll Control Active\\nOpen palm: Scroll Up\\nFist: Scroll Down\\nPress 'q' to exit\")\n","\n","# Main loop for video processing\n","while cap.isOpened(): # Loop as long as the camera is open\n","    success, img = cap.read() # Read a frame from the camera\n","    if not success: break # If frame not read successfully, break the loop\n","\n","    # Flip the image horizontally (for mirror effect) and convert color from BGR to RGB (MediaPipe expects RGB)\n","    img = cv2.flip(cv2.cvtColor(img, cv2.COLOR_BGR2RGB), 1)\n","    # Process the image with the MediaPipe Hands model to detect hands and landmarks\n","    results = hands.process(img)\n","    gesture, handedness = \"none\", \"Unknown\" # Initialize gesture and handedness\n","\n","    # If hands are detected in the frame\n","    if results.multi_hand_landmarks:\n","        # Iterate through each detected hand and its handedness (left/right)\n","        for hand, handedness_info in zip(results.multi_hand_landmarks, results.multi_handedness):\n","            handedness = handedness_info.classification[0].label # Get handedness label (e.g., \"Left\", \"Right\")\n","            gesture = detect_gesture(hand, handedness) # Detect the gesture using our custom function\n","            # Draw hand landmarks and connections on the image\n","            mp_drawing.draw_landmarks(img, hand, mp_hands.HAND_CONNECTIONS)\n","\n","            # Check if enough time has passed since the last scroll action\n","            if (time.time() - last_scroll) > SCROLL_DELAY:\n","                # Perform scroll action based on detected gesture\n","                if gesture == \"scroll_up\": pyautogui.scroll(SCROLL_SPEED) # Scroll up\n","                elif gesture == \"scroll_down\": pyautogui.scroll(-SCROLL_SPEED) # Scroll down\n","                last_scroll = time.time() # Update time of last scroll\n","\n","    # Calculate Frames Per Second (FPS)\n","    fps = 1/(time.time()-p_time) if (time.time()-p_time) > 0 else 0 # Avoid division by zero\n","    p_time = time.time() # Update previous time for next FPS calculation\n","    # Display FPS, Handedness, and Gesture on the image frame\n","    cv2.putText(img, f\"FPS: {int(fps)} | Hand: {handedness} | Gesture: {gesture}\", (10,30),\n","                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255,0,0), 2)\n","    # Convert image back to BGR for OpenCV display and show the frame\n","    cv2.imshow(\"Gesture Control\", cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n","    # Check for 'q' key press to exit the loop\n","    if cv2.waitKey(1) & 0xFF == ord('q'): break\n","\n","# Release the camera resource\n","cap.release()\n","# Destroy all OpenCV windows\n","cv2.destroyAllWindows()"]},{"cell_type":"markdown","metadata":{"id":"4bfc2506"},"source":["### Step-by-Step Execution Explanation\n","\n","This script sets up a real-time hand gesture recognition system using a webcam to control scrolling actions on your computer. Here's how it executes:\n","\n","1.  **Import Libraries (Lines 1-4)**:\n","    *   `cv2` (OpenCV): Used for accessing the webcam, capturing video frames, and displaying them.\n","    *   `time`: Used for calculating frames per second (FPS) and managing the delay between scroll events.\n","    *   `pyautogui`: Used to simulate keyboard/mouse actions, specifically scrolling up or down on the desktop.\n","    *   `mediapipe as mp`: The core library for hand landmark detection.\n","\n","2.  **Initialize MediaPipe Hands (Lines 7-11)**:\n","    *   `mp_hands = mp.solutions.hands`: Accesses the hand detection module from MediaPipe.\n","    *   `hands = mp_hands.Hands(...)`: Creates an instance of the hand detection model. It's configured to detect a maximum of one hand (`max_num_hands=1`) and requires a minimum detection confidence of 70% (`min_detection_confidence=0.7`) to filter out false positives.\n","    *   `mp_drawing = mp.solutions.drawing_utils`: Provides utility functions to draw the detected hand landmarks and connections on the video frame.\n","\n","3.  **Configuration Parameters (Lines 14-17)**:\n","    *   `SCROLL_SPEED`: Determines how many units `pyautogui` scrolls with each gesture detection.\n","    *   `SCROLL_DELAY`: Sets a minimum time (in seconds) between consecutive scroll actions to prevent overly sensitive scrolling.\n","    *   `CAM_WIDTH`, `CAM_HEIGHT`: Define the desired resolution for the webcam feed.\n","\n","4.  **`detect_gesture` Function Definition (Lines 20-39)**:\n","    *   This function takes detected hand `landmarks` and `handedness` (Left/Right) as input.\n","    *   It determines which fingers (index, middle, ring, pinky) are extended by comparing the y-coordinate of their tips to the y-coordinate of their respective knuckles. If the tip is higher (smaller y-value) than the knuckle, the finger is considered extended.\n","    *   It checks the thumb's extension based on `handedness`: for a right hand, if the thumb tip's x-coordinate is greater than its IP joint's x-coordinate, it's extended; for a left hand, it's the opposite.\n","    *   Finally, it returns a string: \"scroll_up\" if all 5 fingers are extended (open palm), \"scroll_down\" if no fingers are extended (fist), and \"none\" for any other hand pose.\n","\n","5.  **Camera Initialization (Lines 42-47)**:\n","    *   `cap = cv2.VideoCapture(0)`: Attempts to open the default webcam (index 0). If you have multiple cameras, you might need a different index.\n","    *   `cap.set(3, CAM_WIDTH)` and `cap.set(4, CAM_HEIGHT)`: Set the width and height of the video capture feed to the configured values.\n","\n","6.  **Variable Initialization (Line 50)**:\n","    *   `last_scroll`, `p_time`: Variables initialized to 0. `last_scroll` keeps track of the last time a scroll event occurred, and `p_time` is used for FPS calculation.\n","\n","7.  **Instructions (Line 53)**:\n","    *   A message is printed to the console informing the user about the active gestures and how to exit the program.\n","\n","8.  **Main Video Processing Loop (Lines 56-91)**:\n","    *   `while cap.isOpened()`: This loop continuously runs as long as the camera is successfully opened.\n","    *   `success, img = cap.read()`: Reads a single frame (`img`) from the webcam. `success` is a boolean indicating if the read was successful.\n","    *   `if not success: break`: If a frame cannot be read (e.g., camera disconnected), the loop breaks.\n","    *   **Image Preprocessing (Line 60)**:\n","        *   `cv2.cvtColor(img, cv2.COLOR_BGR2RGB)`: Converts the color format of the frame from BGR (OpenCV's default) to RGB, which MediaPipe expects.\n","        *   `cv2.flip(..., 1)`: Flips the image horizontally, creating a mirror effect that makes the video feed feel more natural.\n","    *   `results = hands.process(img)`: Sends the processed image to the MediaPipe Hands model to detect hands and extract their landmarks.\n","    *   `gesture, handedness = \"none\", \"Unknown\"`: Resets gesture and handedness for each frame.\n","    *   **Hand Detection and Gesture Recognition (Lines 65-79)**:\n","        *   `if results.multi_hand_landmarks:`: Checks if any hands were detected in the current frame.\n","        *   `for hand, handedness_info in zip(...)`: Iterates through each detected hand (though configured for `max_num_hands=1`, it's good practice to iterate). It extracts the hand landmarks (`hand`) and its classification (`handedness_info`).\n","        *   `handedness = ...label`: Gets whether the detected hand is \"Left\" or \"Right\".\n","        *   `gesture = detect_gesture(hand, handedness)`: Calls the previously defined function to determine the gesture.\n","        *   `mp_drawing.draw_landmarks(...)`: Draws the detected hand's skeleton and landmarks onto the `img` for visual feedback.\n","        *   **Scrolling Logic (Lines 76-79)**:\n","            *   `if (time.time() - last_scroll) > SCROLL_DELAY`: Ensures that the `SCROLL_DELAY` has passed since the last scroll event.\n","            *   `if gesture == \"scroll_up\": pyautogui.scroll(SCROLL_SPEED)`: If the gesture is \"scroll_up\", it simulates scrolling up using `pyautogui`.\n","            *   `elif gesture == \"scroll_down\": pyautogui.scroll(-SCROLL_SPEED)`: If the gesture is \"scroll_down\", it simulates scrolling down.\n","            *   `last_scroll = time.time()`: Updates the `last_scroll` timestamp.\n","    *   **FPS Calculation and Display (Lines 82-86)**:\n","        *   `fps = 1/(time.time()-p_time)`: Calculates the frames per second.\n","        *   `p_time = time.time()`: Updates the previous time for the next FPS calculation.\n","        *   `cv2.putText(...)`: Draws the calculated FPS, detected handedness, and current gesture onto the top-left corner of the `img` frame.\n","    *   **Display Frame (Line 88)**:\n","        *   `cv2.imshow(\"Gesture Control\", cv2.cvtColor(img, cv2.COLOR_RGB2BGR))`: Displays the annotated video frame in a window titled \"Gesture Control\". The image is converted back to BGR for OpenCV's display function.\n","    *   **Exit Condition (Line 91)**:\n","        *   `if cv2.waitKey(1) & 0xFF == ord('q'): break`: Waits for 1 millisecond for a key press. If the 'q' key is pressed, the loop breaks, ending the program.\n","\n","9.  **Cleanup (Lines 94-96)**:\n","    *   `cap.release()`: Releases the webcam resource, making it available for other applications.\n","    *   `cv2.destroyAllWindows()`: Closes all OpenCV windows that were opened by `cv2.imshow()`."]},{"cell_type":"markdown","metadata":{"id":"15b243b3"},"source":["### 1. Install Required Libraries\n","You'll need to install `opencv-python`, `mediapipe`, and `pyautogui`. You can do this using pip:"]},{"cell_type":"code","metadata":{"id":"32b201aa"},"source":["pip install opencv-python mediapipe pyautogui"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"0ba86a5f"},"source":["### 2. macOS Specific Setup for `pyautogui`\n","On macOS, `pyautogui` requires accessibility permissions to control the mouse and keyboard. You will need to:\n","1. Go to `System Settings` (or `System Preferences`).\n","2. Navigate to `Privacy & Security` > `Accessibility`.\n","3. Click the `+` button and add the application you are running your Python script from (e.g., your terminal, IDE like VS Code, or a specific Python interpreter).\n","\n","### 3. Camera Access\n","Ensure your Python environment has permission to access the camera. macOS will typically prompt you for this the first time an application tries to access the camera.\n","\n","### 4. Running the Code\n","The provided code is intended to be run as a standalone Python script on your local machine, where it can open a window using `cv2.imshow` and interact with your desktop using `pyautogui`.\n","\n","#### Why it won't run directly in Google Colab:\n","*   **`cv2.imshow` and `cv2.waitKey`**: These functions are used to display a video feed in a dedicated GUI window. Colab notebooks run on remote servers and do not have a local display to show these windows.\n","*   **`pyautogui`**: This library performs GUI automation (like scrolling). It needs direct access to your local desktop, which is not possible from a remote Colab environment.\n","*   **`cv2.VideoCapture(0)`**: While `cv2.VideoCapture(0)` attempts to access your default camera, in a Colab environment, it would try to access the camera of the remote server, not your local machine. Live camera feeds from your local machine are generally handled by specific Colab or browser-based camera integrations, not direct `cv2.VideoCapture(0)`."]}]}