{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOBZSeBdwIicwHsbwq0Fqp3"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"NMnBz0xQMvq6"},"outputs":[],"source":["import colorama # Import the colorama library for colored terminal output\n","from colorama import Fore, Style # Import specific modules from colorama for foreground colors and styles\n","from textblob import TextBlob # Import TextBlob for sentiment analysis\n","\n","# Initialize colorama for colored output on different terminals\n","colorama.init()\n","\n","# Display a welcome message with emojis and cyan color\n","print(f\"{Fore.CYAN} 🐍 Welcome to Sentiment Spy! 🐍{Style.RESET_ALL}\")\n","\n","# Prompt the user to enter their name, remove leading/trailing whitespace\n","user_name = input(f\"{Fore.MAGENTA}Please enter your name: {Style.RESET_ALL}\").strip()\n","# If the user doesn't provide a name, set a default name\n","if not user_name:\n","    user_name = \"Mystery Agent\"  # Fallback if user doesn't provide a name\n","\n","# Initialize an empty list to store the conversation history as tuples (text, polarity, sentiment_type)\n","conversation_history = []\n","\n","# Greet the user by their name and explain the program's functionality\n","print(f\"\\n{Fore.CYAN}Hello, Agent {user_name}!\")\n","print(f\"Type a Sentence and I will analyze your sentences with TextBlob and show you the sentiment. \")\n","# Inform the user about available commands (reset, history, exit)\n","print(f\"Type {Fore.YELLOW}reset{Fore.CYAN}, {Fore.YELLOW}history{Fore.CYAN}, \"\n","    f\"or {Fore.YELLOW}exit{Fore.CYAN} to quit.{Style.RESET_ALL}\\n\")\n","\n","# Start an infinite loop for continuous user interaction\n","while True:\n","    # Prompt the user for input and remove leading/trailing whitespace\n","    user_input = input(f\"{Fore.GREEN}>> {Style.RESET_ALL}\").strip()\n","\n","    # If the user input is empty, ask them to re-enter\n","    if not user_input:\n","        print(f\"{Fore.RED}Please enter some text or a valid command.{Style.RESET_ALL}\")\n","        continue # Continue to the next iteration of the loop\n","\n","    # Check if the user input matches any of the commands (case-insensitive)\n","    if user_input.lower() == \"exit\":\n","        # Print an exit message and break out of the loop\n","        print(f\"\\n{Fore.BLUE} Exiting Sentiment Spy. Farewell, Agent {user_name}! 😊{Style.RESET_ALL}\")\n","        break\n","\n","    elif user_input.lower() == \"reset\":\n","        # Clear the entire conversation history\n","        conversation_history.clear()\n","        print(f\"{Fore.CYAN} All conversation history cleared!{Style.RESET_ALL}\")\n","        continue # Continue to the next iteration of the loop\n","\n","    elif user_input.lower() == \"history\":\n","        # Check if there is any history to display\n","        if not conversation_history:\n","            print(f\"{Fore.YELLOW}No conversation history yet.{Style.RESET_ALL}\")\n","        else:\n","            # Print a header for the conversation history\n","            print(f\"{Fore.CYAN} Conversation History:{Style.RESET_ALL}\")\n","            # Iterate through the history with an index\n","            for idx, (text, polarity, sentiment_type) in enumerate(conversation_history, start=1):\n","                # Determine color and emoji based on sentiment type\n","                if sentiment_type == \"Positive\":\n","                    color = Fore.GREEN\n","                    emoji = \"😊\"\n","                elif sentiment_type == \"Negative\":\n","                    color = Fore.RED\n","                    emoji = \"😞\"\n","                else:\n","                    color = Fore.YELLOW\n","                    emoji = \"😭\"\n","\n","                # Print each historical entry with its sentiment, polarity, color, and emoji\n","                print(f\"{idx}. {color}{emoji} {text} \"\n","                    f\"Polarity: {polarity:.2f}, {sentiment_type}{Style.RESET_ALL}\")\n","        continue # Continue to the next iteration of the loop\n","\n","    # Analyze the sentiment of the user's input using TextBlob and get the polarity score\n","    polarity = TextBlob(user_input).sentiment.polarity\n","    # Classify sentiment based on polarity thresholds\n","    if polarity > 0.25:\n","        sentiment_type = \"Positive\"\n","        color = Fore.GREEN\n","        emoji = \"😊\"\n","    elif polarity < -0.25:\n","        sentiment_type = \"Negative\"\n","        color = Fore.RED\n","        emoji = \"😞\"\n","    else:\n","        sentiment_type = \"Neutral\"\n","        color = Fore.YELLOW\n","        emoji = \"😭\"\n","\n","    # Store the user's input, its polarity, and sentiment type in the conversation history\n","    conversation_history.append((user_input, polarity, sentiment_type))\n","\n","    # Print the detected sentiment, polarity, with appropriate color and emoji\n","    print(f\"{color}{emoji} {sentiment_type} sentiment detected! \"\n","        f\"Polarity: {polarity:.2f}\")"]}]}