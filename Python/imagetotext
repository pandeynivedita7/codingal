p else f\"[Error] {err}\" # Return caption or error message\n","\n","def print_menu(): # Function to print the main menu options\n","    print(f\"\"\"{Style.BRIGHT}{Fore.GREEN}\n","================ Image-to-Text Conversion =================\n","Select output type:\n","1. Caption (5 words)\n","2. Description (30 words)\n","3. Summary (50 words)\n","4. Exit\n","=============================================================\n","\"\"\")\n","\n","def main(): # Main function to run the image-to-text conversion program\n","    image_path = input(f\"{Fore.BLUE}Enter the path of the image (e.g., test.jpg): {Style.RESET_ALL}\") # Prompt user for image path\n","    if not os.path.exists(image_path): # Check if the provided image path exists\n","        print(f\"{Fore.RED}❌ The file '{image_path}' does not exist.\") # Print error if file not found\n","        return # Exit function\n","    try:\n","        Image.open(image_path) # Try to open the image using Pillow to validate it\n","    except Exception as e: # Catch exceptions if image opening fails\n","        print(f\"{Fore.RED}❌ Failed to open image: {e}\") # Print error message\n","        return # Exit function\n","\n","    basic_caption = get_basic_caption(image_path) # Generate an initial basic caption\n","    print(f\"{Fore.YELLOW}📝 Basic caption: {Style.BRIGHT}{basic_caption}\\n\") # Print the basic caption\n","\n","    while True: # Start an infinite loop for the menu interaction\n","        print_menu() # Display the menu\n","        choice = input(f\"{Fore.CYAN}Enter your choice (1-4): {Style.RESET_ALL}\").strip() # Get user's choice\n","\n","        if basic_caption.startswith(\"[Error]\") and choice in {\"1\", \"2\", \"3\"}: # If basic caption failed and user chooses an option other than exit\n","            basic_caption = get_basic_caption(image_path) # Re-attempt to get basic caption\n","            print(f\"{Fore.YELLOW}📝 Basic caption: {Style.BRIGHT}{basic_caption}\\n\") # Print the (possibly re-generated) basic caption\n","\n","        if choice == \"1\": # If user chose option 1 (5-word caption)\n","            if basic_caption.startswith(\"[Error]\"): # Check if basic caption generation failed\n","                print(f\"{Fore.RED}❌ Caption (5 words): {Style.BRIGHT}{basic_caption}\\n\") # Print error\n","            else:\n","                out = _ensure_sentence_end(_exact_n_words(basic_caption, 5)) # Get exactly 5 words and ensure sentence ends properly\n","                print(f\"{Fore.GREEN}✅ Caption (5 words): {Fore.YELLOW}{Style.BRIGHT}{out}\\n\") # Print the 5-word caption\n","\n","        elif choice == \"2\": # If user chose option 2 (30-word description)\n","            if basic_caption.startswith(\"[Error]\"): # Check if basic caption generation failed\n","                print(f\"{Fore.RED}❌ Failed to generate description: {basic_caption}\") # Print error\n","                continue # Continue to next loop iteration\n","            prompt = (\"Rewrite as EXACTLY 30 words. Single paragraph. One complete sentence. \" # Construct prompt for 30-word description\n","                      \"End with a period. No title/bullets.\\n\\nText: \" + basic_caption)\n","            try:\n","                out = generate_exact_sentence(prompt, 30, max_new_tokens=220, tries=6) # Call generate_exact_sentence for 30 words\n","                print(f\"{Fore.GREEN}✅ Description (30 words): {Fore.YELLOW}{Style.BRIGHT}{out}\\n\") # Print the 30-word description\n","            except Exception as e: # Catch exceptions during generation\n","                print(f\"{Fore.RED}❌ Failed to generate description: {e}\") # Print error\n","\n","        elif choice == \"3\": # If user chose option 3 (50-word summary)\n","            if basic_caption.startswith(\"[Error]\"): # Check if basic caption generation failed\n","                print(f\"{Fore.RED}❌ Failed to generate summary: {basic_caption}\") # Print error\n","                continue # Continue to next loop iteration\n","            prompt = (\"Write EXACTLY 50 words. Single paragraph. One complete sentence. \" # Construct prompt for 50-word summary\n","                      \"End with a period. No title/bullets/extra text.\\n\\nImage seed: \" + basic_caption)\n","            try:\n","                out = generate_exact_sentence(prompt, 50, max_new_tokens=280, tries=7) # Call generate_exact_sentence for 50 words\n","                print(f\"{Fore.GREEN}✅ Summary (50 words): {Fore.YELLOW}{Style.BRIGHT}{out}\\n\") # Print the 50-word summary\n","            except Exception as e: # Catch exceptions during generation\n","                print(f\"{Fore.RED}❌ Failed to generate summary: {e}\") # Print error\n","\n","        elif choice == \"4\": # If user chose option 4 (Exit)\n","            print(f\"{Fore.GREEN}👋 Goodbye!\") # Print goodbye message\n","            break # Exit the loop and end the program\n","        else:\n","            print(f\"{Fore.RED}❌ Invalid choice. Please enter 1-4.\") # Handle invalid menu choices\n","\n","if __name__ == \"__main__\": # Standard boilerplate to run main() when script is executed\n","    main() # Call the main function"]}]}