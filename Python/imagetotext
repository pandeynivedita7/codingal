I\n","HEADERS = {\"Authorization\": f\"Bearer {HF_API_KEY}\", \"Content-Type\": \"application/json\"} # Set up authorization headers with the API key\n","\n","VISION_MODELS = [ # List of vision models to be used for image-to-text tasks\n","    \"Qwen/Qwen3-VL-8B-Instruct:together\",\n","    \"Qwen/Qwen3-VL-32B-Instruct:together\",\n","    \"Qwen/Qwen2.5-VL-7B-Instruct:together\",\n","    \"Qwen/Qwen2.5-VL-32B-Instruct:together\",\n","    \"Qwen/Qwen2-VL-2B-Instruct:together\",\n","]\n","TEXT_MODELS = [ # List of text models to be used for text-to-text tasks\n","    \"Qwen/Qwen2.5-7B-Instruct:together\",\n","    \"Qwen/Qwen2.5-14B-Instruct:together\",\n","    \"Qwen/Qwen2.5-32B-Instruct:together\",\n","    \"mistralai/Mistral-7B-Instruct-v0.3:together\",\n","    \"mistralai/Mixtral-8x7B-Instruct-v0.1:together\",\n","]\n","\n","def _data_url(path: str) -> str: # Function to convert a local image file to a base64 data URL\n","    with open(path, \"rb\") as f: # Open the image file in binary read mode\n","        return \"data:image/jpeg;base64,\" + base64.b64encode(f.read()).decode(\"utf-8\") # Encode image to base64 and prepend data URL prefix\n","\n","def query_hf_api(payload: dict): # Function to query the Hugging Face API\n","    try:\n","        r = requests.post(ROUTER_URL, headers=HEADERS, json=payload, timeout=120) # Send POST request to the API with payload and headers\n","    except requests.RequestException as e: # Catch request-related exceptions\n","        return None, f\"Request failed: {e}\" # Return None and error message\n","    if r.status_code != 200: # Check if the request was successful (status code 200)\n","        try:\n","            j = r.json() # Try to parse JSON response for error details\n","            msg = j.get(\"error\", {}).get(\"message\") or str(j) # Extract error message or full JSON if available\n","        except Exception: # Fallback if JSON parsing fails\n","            msg = (r.text or \"\").strip() or r.reason or \"Request failed.\" # Get error from text response or reason\n","        return None, f\"Status {r.status_code}: {msg}\" # Return None and formatted error message\n","    try:\n","        return r.json(), None # Return the JSON response and no error if successful\n","    except Exception: # Catch exception if response is not valid JSON\n","        return None, \"Non-JSON response received from the API.\" # Return None and error message\n","\n","def _extract_text(data) -> str: # Function to extract text content from the API response\n","    msg = (data or {}).get(\"choices\", [{}])[0].get(\"message\", {}) or {} # Navigate through JSON to find the message content\n","    return (msg.get(\"content\") or \"\").strip() # Return the extracted text, stripped of whitespace\n","\n","def _run_models(models, messages, max_tokens=160, temperature=0.3): # Function to run a list of models sequentially until one succeeds\n","    last_err = None # Initialize last error variable\n","    for model in models: # Iterate through each model in the list\n","        data, err = query_hf_api({\"model\": model, \"messages\": messages, \"max_tokens\": max_tokens, \"temperature\": temperature}) # Query API with current model\n","        if err: # If an error occurred with the current model\n","            last_err = err # Store the error\n","            continue # Try the next model\n","        out = _extract_text(data) # Extract text from successful response\n","        if out: # If text was successfully extracted\n","            return out, None # Return the text and no error\n","        last_err = \"Empty response from model.\" # Set error if response is empty\n","    return None, last_err or \"All models failed.\" # Return None and the last error if all models fail\n","\n","def _words(text: str): # Helper function to split text into words using regex\n","    return re.findall(r\"\\S+\", (text or \"\").strip()) # Find all non-whitespace sequences\n","\n","def _exact_n_words(text: str, n: int) -> str: 