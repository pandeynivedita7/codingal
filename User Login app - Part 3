{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMA2U9Abh+NASi+/BVllf3V"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"idxJjNK0yEHN"},"outputs":[],"source":["import re # Import the regular expression module\n","import mysql.connector # Import the MySQL connector library\n","from flask import Flask, render_template, request # Import necessary Flask components\n","\n","app = Flask(__name__) # Initialize the Flask application\n","\n","@app.route('/register', methods=['GET','POST']) # Define the route for the registration page, allowing GET and POST requests\n","def register():\n","    msg = '' # Initialize an empty message variable\n","    # Check if the request method is POST and if username, password, and email are present in the form data\n","    if request.method == 'POST' and 'username' in request.form and 'password' in request.form and 'email' in request.form:\n","        username = request.form['username'] # Get username from the form\n","        password = request.form['password'] # Get password from the form\n","        email = request.form['email'] # Get email from the form\n","\n","        # Establish a connection to the MySQL database\n","        mydb = mysql.connector.connect(\n","            host='remoteysql.com',\n","            user='Rz8hqnlk4',\n","            password='nd6wK03xe0',\n","            database='Rz8hqnlk4'\n","        )\n","        mycursor = mydb.cursor() # Create a cursor object to execute SQL queries\n","        print(username) # Print the username to the console (for debugging purposes)\n","        # Execute a SELECT query to check if an account with the given username and email already exists\n","        mycursor.execute('SELECT * FROM LoginDetails WHERE Name = %s AND Email_id = %s', (username, email,))\n","        account = mycursor.fetchone() # Fetch the first matching record\n","        print(account) # Print the fetched account (for debugging purposes)\n","\n","        if account: # If an account is found\n","            msg = 'Account already exists!' # Set an error message\n","        # Validate email format using a regular expression\n","        elif not re.match(r'[^\\s@]+@[^\\s@]+\\.[^\\s@]+', email): # Corrected regex for email validation\n","            msg = 'Invalid email address!' # Set an error message for invalid email\n","        # Validate username format using a regular expression (only alphanumeric characters)\n","        elif not re.match(r'^[A-Za-z0-9]+$', username): # Corrected regex for username validation\n","            msg = 'Username must contain only characters and numbers!' # Set an error message for invalid username\n","        elif not username or not password or not email: # Check if any required field is empty\n","            msg = 'Kindly fill the details!' # Set an error message for incomplete details\n","        else: # If all validations pass and no existing account\n","            # Execute an INSERT query to add the new user details to the database\n","            mycursor.execute('INSERT INTO LoginDetails (Name, Password, Email_id) VALUES (%s, %s, %s)', (username, password, email))\n","            mydb.commit() # Commit the changes to the database\n","            msg = 'Your Registration is Successful' # Set a success message\n","            name = username # Store the username\n","            # Render the index.html template with the success message and username\n","            return render_template('index.html', msg=msg, name=name)\n","    elif request.method == 'POST': # If the request method is POST but not all required form fields were present\n","        msg = 'Kindly fill the details!' # Set a message indicating incomplete details\n","    # Render the registration.html template with any messages\n","    return render_template('registration.html', msg=msg)"]}]}