  # Scales the player image to 50x50 pixels\n","except pygame.error as e:  # Catches any Pygame errors during image loading\n","    print(f\"Error loading rocket: {e}\")  # Prints an error message\n","    sys.exit()  # Exits the game if the player image cannot be loaded\n","\n","player_x = (screen_width - 50) // 2  # Sets the initial x-position of the player (centered horizontally)\n","player_y = screen_height - 60  # Sets the initial y-position of the player (near the bottom)\n","player_speed = 5  # Sets the movement speed of the player\n","player_lives = 3  # Sets the initial number of lives for the player\n","\n","# Player bullets\n","player_bullets = []  # Creates an empty list to store active player bullets\n","bullet_speed = 7  # Sets the speed of player bullets\n","\n","# Enemy setup\n","try:  # Attempts to load the enemy image\n","    enemy_image = pygame.image.load(r\"C:\\Users\\Masth\\Downloads\\enemy.png\")  # Loads the enemy image\n","    enemy_image = pygame.transform.scale(enemy_image, (40, 40))  # Scales the enemy image to 40x40 pixels\n","except pygame.error as e:  # Catches any Pygame errors during image loading\n","    print(f\"Error loading alien: {e}\")  # Prints an error message\n","    sys.exit()  # Exits the game if the enemy image cannot be loaded\n","\n","enemies = []  # Creates an empty list to store active enemies\n","enemy_speed = 2  # Sets the movement speed of enemies\n","enemy_bullets = []  # Creates an empty list to store active enemy bullets\n","enemy_bullet_speed = 5  # Sets the speed of enemy bullets\n","spawn_delay = 1000  # ms  # Sets the delay in milliseconds between enemy spawns\n","\n","score = 0  # Initializes the player's score to 0\n","font = pygame.font.Font(None, 36)  # Creates a font object for displaying text (None for default font, size 36)\n","\n","# Timers\n","pygame.time.set_timer(pygame.USEREVENT + 1, spawn_delay)  # Sets a custom event (USEREVENT+1) to trigger enemy spawning at `spawn_delay` intervals\n","pygame.time.set_timer(pygame.USEREVENT + 2, 800)  # Sets a custom event (USEREVENT+2) to trigger enemy shooting at 800ms intervals\n","\n","# Game over flag\n","game_over = False  # A boolean flag to indicate if the game is over\n","\n","# Main game loop\n","running = True  # A boolean flag to keep the game loop running\n","clock = pygame.time.Clock()  # Creates a Clock object to control frame rate\n","\n","while running:  # The main game loop continues as long as `running` is True\n","    clock.tick(60)  # Limits the frame rate to 60 frames per second\n","    screen.blit(background_image, (0, 0))  # Draws the background image at the top-left corner (0,0)\n","\n","    for event in pygame.event.get():  # Iterates through all events captured by Pygame\n","        if event.type == pygame.QUIT:  # Checks if the user clicked the close button\n","            running = False  # Sets `running` to False to exit the game loop\n","\n","        # Spawn enemies\n","        if event.type == pygame.USEREVENT + 1 and not game_over:  # Checks if the enemy spawn event occurred and the game is not over\n","            side = random.choice([\"left\", \"right\"])  # Randomly chooses a side for the enemy to spawn (left or right)\n","            y_pos = random.randint(50, 300)  # Randomly chooses a y-position for the enemy\n","            if side == \"left\":  # If spawning on the left side\n","                x_pos = 0  # Start at x=0\n","                direction = 1  # Move right (positive x-direction)\n","            else:  # If spawning on the right side\n","                x_pos = screen_width - 40  # Start at the right edge, accounting for enemy width\n","                direction = -1  # Move left (negative x-direction)\n","            enemies.append({\"x\": x_pos, \"y\": y_pos, \"dir\": direction})  # Adds a new enemy dictionary to the `enemies` list\n","\n","        # Enemy shooting\n","        if event.type == pygame.USEREVENT + 2 and not game_over:  # Checks if the enemy shooting event occurred and the game is not over\n","            if enemies:  # Ensures there are enemies on screen\n","                shooter = random.choice(enemies)  # Randomly selects an enemy to shoot\n","                enemy_bullets.append({\"x\": shooter[\"x\"] + 20, \"y\": shooter[\"y\"] + 40})  # Adds a new enemy bullet, positioned relative to the shooter\n","\n","    if not game_over:  # Only process game logic if the game is not over\n","        # Player movement\n","        keys = pygame.key.get_pressed()  # Gets the state of all keyboard keys\n","        if keys[pygame.K_LEFT]:  # Checks if the left arrow key is pressed\n","            player_x -= player_speed  # Moves the player left\n","        if keys[pygame.K_RIGHT]:  # Checks if the right arrow key is pressed\n","            player_x += player_speed  # Moves the player right\n","        if keys[pygame.K_SPACE]:  # Checks if the spacebar is pressed\n","            if len(player_bullets) < 5:  # Limits the number of player bullets on screen to 5\n","                player_bullets.append({\"x\": player_x + 20, \"y\": player_y})  # Adds a new player bullet, positioned relative to the player\n","\n","        # Keep player on screen\n","        player_x = max(0, min(player_x, screen_width - 50))  # Clamps the player's x-position to stay within screen bounds\n","\n","        # Move enemies\n","        for enemy in enemies:  # Iterates through each enemy\n","            enemy[\"x\"] += enemy[\"dir\"] * enemy_speed  # Moves the enemy horizontally based on its direction and speed\n","        enemies = [e for e in enemies if 0 <= e[\"x\"] <= screen_width - 40]  # Removes enemies that have moved off-screen\n","\n","        # Move player bullets\n","        for bullet in player_bullets:  # Iterates through each player bullet\n","            bullet[\"y\"] -= bullet_speed  # Moves the bullet upwards\n","        player_bullets = [b for b in player_bullets if b[\"y\"] > 0]  # Removes player bullets that have moved off the top of the screen\n","\n","        # Move enemy bullets\n","        for bullet in enemy_bullets:  # Iterates through each enemy bullet\n","            bullet[\"y\"] += enemy_bullet_speed  # Moves the bullet downwards\n","        enemy_bullets = [b for b in enemy_bullets if b[\"y\"] < screen_height]  # Removes enemy bullets that have moved off the bottom of the screen\n","\n","        # Check collisions: player bullets vs enemies\n","        for bullet in player_bullets[:]:  # Iterates through a copy of the player bullets list to allow removal during iteration\n","            for enemy in enemies[:]:  # Iterates through a copy of the enemies list\n","                if enemy[\"x\"] < bullet[\"x\"] < enemy[\"x\"] + 40 and enemy[\"y\"] < bullet[\"y\"] < enemy[\"y\"] + 40:  # Checks for collision between bullet and enemy (simple bounding box check)\n","                    player_bullets.remove(bullet)  # Removes the hit player bullet\n","                    enemies.remove(enemy)  # Removes the hit enemy\n","                    score += 10  # Increases the score\n","                    break  # Breaks from the inner loop to avoid checking the same bullet against other enemies\n","\n","        # Check collisions: enemy bullets vs player\n","        for bullet in enemy_bullets[:]:  # Iterates through a copy of the enemy bullets list\n","            if player_x < bullet[\"x\"] < player_x + 50 and player_y < bullet[\"y\"] < player_y + 50:  # Checks for collision between enemy bullet and player\n","                enemy_bullets.remove(bullet)  # Removes the hit enemy bullet\n","                player_lives -= 1  # Decreases player lives\n","                if player_lives <= 0:  # Checks if player lives have reached zero\n","                    game_over = True  # Sets the game over flag to True\n","\n","        # Draw player\n","        screen.blit(player, (player_x, player_y))  # Draws the player image on the screen at its current position\n","\n","        # Draw enemies\n","        for enemy in enemies:  # Iterates through each enemy\n","            screen.blit(enemy_image, (enemy[\"x\"], enemy[\"y\"]))  # Draws the enemy image on the screen\n","\n","        # Draw bullets\n","        for bullet in player_bullets:  # Iterates through each player bullet\n","            pygame.draw.rect(screen, WHITE, (bullet[\"x\"], bullet[\"y\"], 5, 10))  # Draws a white rectangle for the player bullet\n","        for bullet in enemy_bullets:  # Iterates through each enemy bullet\n","            pygame.draw.rect(screen, RED, (bullet[\"x\"], bullet[\"y\"], 5, 10))  # Draws a red rectangle for the enemy bullet\n","\n","        # Draw score and lives\n","        score_text = font.render(f\"Score: {score}\", True, WHITE)  # Renders the score text\n","        lives_text = font.render(f\"Lives: {player_lives}\", True, WHITE)  # Renders the lives text\n","        screen.blit(score_text, (10, 10))  # Draws the score text at the top-left\n","        screen.blit(lives_text, (screen_width - 120, 10))  # Draws the lives text at the top-right\n","    else:  # If game_over is True\n","        # Game Over screen\n","        over_text = font.render(\"GAME OVER\", True, RED)  # Renders \"GAME OVER\" text in red\n","        screen.blit(over_text, (screen_width // 2 - 100, screen_height // 2 - 20))  # Draws \"GAME OVER\" text in the center of the screen\n","        score_text = font.render(f\"Final Score: {score}\", True, WHITE)  # Renders the final score text\n","        screen.blit(score_text, (screen_width // 2 - 100, screen_height // 2 + 20))  # Draws the final score below \"GAME OVER\"\n","\n","    pygame.display.flip()  # Updates the entire screen to show what has been drawn\n","\n","pygame.quit()  # Uninitializes all Pygame modules\n","```"]}]}