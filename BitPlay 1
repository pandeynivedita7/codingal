{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"JbFZkW2VXa4s"},"outputs":[],"source":["n = 52   # Initialize a variable 'n' with the integer value 52. The binary representation of 52 is 110100.\n","\n","def bits(n):\n","  # Define a function named 'bits' that takes one argument 'n'.\n","  # The `bin(n)` function converts an integer to its binary string representation (e.g., '0b110100').\n","  # `[2:]` slices the string to remove the '0b' prefix, leaving only the binary digits.\n","  return bin(n)[2:]\n","\n","# Print the original number 'n' and its binary representation obtained from the 'bits' function.\n","print('n =', n, '->', bits(n))\n","\n","# Get the binary string and count the occurrences of '1' to find the number of set bits.\n","print('Set bits  (1s):', bits(n).count('1'))\n","\n","# Get the binary string and count the occurrences of '0' to find the number of zero bits.\n","print('Zero bits (0s):', bits(n).count('0'))\n","\n","# Expected Output:\n","# n = 52 -> 110100\n","# Set bits  (1s): 3\n","# Zero bits (0s): 3"]},{"cell_type":"code","source":["# PART 2: Counting Set Bits using bitwise operations\n","count, temp = 0, n  # Initialize 'count' to 0 (to store the number of set bits) and 'temp' with the value of 'n'.\n","while temp:         # Loop continues as long as 'temp' is not zero (i.e., there are still bits to check).\n","    if temp & 1:    # Perform a bitwise AND operation between 'temp' and 1.\n","                    # If the last bit of 'temp' is 1, the result will be 1 (True), otherwise 0 (False).\n","        count += 1  # If the last bit is 1 (set), increment the 'count'.\n","    temp >>= 1      # Right-shift 'temp' by 1 bit. This effectively divides 'temp' by 2 and moves the next bit to the last position for the next iteration.\n","print('Set bits in', n, ':', count) # After the loop finishes, print the original number 'n' and the total 'count' of set bits.\n","\n","# Trace for n=52 (binary 110100) — reading right to left:\n","# Initial: n = 52, count = 0, temp = 52\n","# Iteration 1: temp=52 (110100). 52 & 1 = 0. temp >>= 1 -> temp = 26 (11010).\n","# Iteration 2: temp=26 (11010). 26 & 1 = 0. temp >>= 1 -> temp = 13 (1101).\n","# Iteration 3: temp=13 (1101). 13 & 1 = 1. count = 1. temp >>= 1 -> temp = 6 (110).\n","# Iteration 4: temp=6 (110). 6 & 1 = 0. temp >>= 1 -> temp = 3 (11).\n","# Iteration 5: temp=3 (11). 3 & 1 = 1. count = 2. temp >>= 1 -> temp = 1 (1).\n","# Iteration 6: temp=1 (1). 1 & 1 = 1. count = 3. temp >>= 1 -> temp = 0.\n","# Loop terminates as temp is now 0.\n","# Final Output: Set bits in 52 : 3"],"metadata":{"id":"Ks-1-sBaYt5d"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# PART 3: The First Set Bit\n","pos, temp = 1, n  # Initialize 'pos' to 1 (representing the position of the bit, starting from 1 for the least significant bit) and 'temp' with the value of 'n'.\n","while temp:         # Loop continues as long as 'temp' is not zero.\n","    if temp & 1:    # Check if the least significant bit of 'temp' is set (1).\n","        break       # If it's set, we've found the first set bit, so exit the loop.\n","    pos += 1        # If the current least significant bit is not set (0), increment 'pos' to check the next bit position.\n","    temp >>= 1      # Right-shift 'temp' by 1 bit to move the next bit to the least significant position.\n","print('First set bit of', n, '-> position', pos) # Print the original number 'n' and the position of its first set bit.\n","\n","# Trace for n=52 (binary 110100) from right to left (least significant bit is position 1):\n","# Initial: n = 52, pos = 1, temp = 52\n","# Iteration 1: temp=52 (110100). 52 & 1 = 0 (not set). pos = 2. temp >>= 1 -> temp = 26 (11010).\n","# Iteration 2: temp=26 (11010). 26 & 1 = 0 (not set). pos = 3. temp >>= 1 -> temp = 13 (1101).\n","# Iteration 3: temp=13 (1101). 13 & 1 = 1 (set). Break the loop.\n","# Final Output: First set bit of 52 -> position 3"],"metadata":{"id":"xLGYGBfaaYWr"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# PART 4: Building a Bit Mask\n","# This section demonstrates how to create bit masks using the left-shift operator (<<).\n","# A bit mask is a sequence of bits used to select specific bits from a binary number.\n","\n","for i in range(6):\n","    # Loop 'i' from 0 to 5 (exclusive of 6).\n","    # In each iteration, '1 << i' performs a left bit shift on the number 1 by 'i' positions.\n","    # This effectively creates a number with only the i-th bit set to 1 (starting from the rightmost bit as position 0).\n","    # The f-string formats the output:\n","    #   - '1 << {i}' shows the operation.\n","    #   - '{1 << i:2d}' shows the decimal value of the result, right-aligned with a minimum width of 2.\n","    #   - '{bits(1 << i)}' shows the binary representation of the result using the previously defined 'bits' function.\n","    print(f'  1 << {i} = {1 << i:2d} -> {bits(1 << i)}')\n","\n","# Output explanation:\n","#   1 << 0 =  1 -> 1       (Binary 000001: 1 shifted left 0 times)\n","#   1 << 1 =  2 -> 10      (Binary 000010: 1 shifted left 1 time)\n","#   1 << 2 =  4 -> 100     (Binary 000100: 1 shifted left 2 times)\n","#   1 << 3 =  8 -> 1000    (Binary 001000: 1 shifted left 3 times)\n","#   1 << 4 = 16 -> 10000   (Binary 010000: 1 shifted left 4 times)\n","#   1 << 5 = 32 -> 100000  (Binary 100000: 1 shifted left 5 times)\n","# As observed, each step moves the single set bit one position to the left, effectively multiplying the value by 2."],"metadata":{"id":"fAKB9tj7cefT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# PART 5: Check if Nth Bit is Set\n","print('Bits of', n, '->', bits(n) + ':') # Print the binary representation of 'n' for reference.\n","\n","# Loop through bit positions from 1 to 6 (inclusive).\n","# Bit positions are usually counted from 0 (rightmost) or 1 (rightmost).\n","# Here, 'bit' refers to the 1-based position.\n","for bit in range(1, 7):\n","    # Calculate the mask for the current bit position:\n","    # (bit - 1) converts the 1-based position to a 0-based index for shifting.\n","    # (1 << (bit - 1)) creates a mask with only the target bit set (e.g., for bit 1, mask is 000001; for bit 3, mask is 000100).\n","    # n & (1 << (bit - 1)) performs a bitwise AND operation between 'n' and the mask.\n","    # If the corresponding bit in 'n' is set (1), the result of the AND will be non-zero (True).\n","    # If the corresponding bit in 'n' is not set (0), the result will be zero (False).\n","    result = 'SET' if n & (1 << (bit - 1)) else 'NOT SET'\n","    print(f'  bit {bit}:', result) # Print the bit position and whether it's SET or NOT SET.\n","\n","# Output (n=52 -> 110100, reading bit positions 1-6):\n","# This section provides a trace of the output for n=52:\n","#   bit 1: NOT SET   (The rightmost bit of 110100 is 0)\n","#   bit 2: NOT SET   (The second bit from the right is 0)\n","#   bit 3: SET       (The third bit from the right is 1, which corresponds to the 4's place value)\n","#   bit 4: NOT SET   (The fourth bit from the right is 0)\n","#   bit 5: SET       (The fifth bit from the right is 1, which corresponds to the 16's place value)\n","#   bit 6: SET       (The sixth bit from the right is 1, which corresponds to the 32's place value)"],"metadata":{"id":"S2vvSn3hdKcn"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# BIT PLAY\n","# Topics: Set Bits & Zeros | Count Set Bits | First Set Bit | Bit Masks | Check Nth Bit\n","\n","n = 52   # binary: 110100\n","\n","def bits(n): return bin(n)[2:]\n","\n","# PART 1: Set Bits and Zero Bits\n","print(\"=== Bit Play ===\")\n","print(\"n =\", n, \"->\", bits(n))\n","print(\"Set bits  (1s):\", bits(n).count('1'))\n","print(\"Zero bits (0s):\", bits(n).count('0'))\n","print()\n","\n","# PART 2: Counting Set Bits\n","count, temp = 0, n\n","while temp:\n","    if temp & 1: count += 1\n","    temp >>= 1\n","print(\"Set bits in\", n, \":\", count)\n","print()\n","\n","# PART 3: The First Set Bit\n","pos, temp = 1, n\n","while temp:\n","    if temp & 1: break\n","    pos += 1\n","    temp >>= 1\n","print(\"First set bit of\", n, \"-> position\", pos)\n","print()\n","\n","# PART 4: Building a Bit Mask\n","print(\"Bit masks (1 << i):\")\n","for i in range(6):\n","    print(f\"  1 << {i} = {1 << i:2d} -> {bits(1 << i)}\")\n","print()\n","\n","# PART 5: Check if Nth Bit is Set\n","print(\"Bits of\", n, \"->\", bits(n) + \":\")\n","for bit in range(1, 7):\n","    result = \"SET\" if n & (1 << (bit - 1)) else \"NOT SET\"\n","    print(f\"  bit {bit}:\", result)\n"],"metadata":{"id":"lc2eIhP_dzT-"},"execution_count":null,"outputs":[]}]}