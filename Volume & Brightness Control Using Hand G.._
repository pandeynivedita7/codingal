{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNXm4G2q0QI3Fap9C3bjyZq"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"Y0NMcfuLOw5w"},"outputs":[],"source":["import cv2 # OpenCV for video capture and image processing\n","import mediapipe as mp # MediaPipe for hand detection and landmark tracking\n","import numpy as np # NumPy for numerical operations, especially interpolation\n","import subprocess # For running shell commands like osascript for macOS system control\n","\n","# Initialize MediaPipe Hands module\n","Hands = mp.solutions.hands\n","hands = Hands.Hands(min_detection_confidence=0.7, min_tracking_confidence=0.7) # Configure hand detection with confidence thresholds\n","draw = mp.solutions.drawing_utils # Utility for drawing hand landmarks\n","\n","# Define landmark points for thumb tip and index finger tip\n","TH, IX = Hands.HandLandmark.THUMB_TIP, Hands.HandLandmark.INDEX_FINGER_TIP\n","\n","# --- Audio Control Setup (using osascript for macOS) ---\n","# osascript volume is typically 0-100\n","min_volume, max_volume = 0, 100\n","print(\"Using osascript for volume and brightness control on macOS.\") # Indicate method for macOS\n","\n","# --- Webcam Setup (using OpenCV) ---\n","cap = cv2.VideoCapture(0) # Initialize video capture from the default webcam (0)\n","if not cap.isOpened(): # Check if the webcam was successfully opened\n","    print(\"Error: Webcam not accessible. Please ensure your camera is connected and not in use.\")\n","    # In a local script, exit() is common. In Colab, you might prefer to just let the cell finish.\n","    exit()\n","\n","# --- Window Setup (using OpenCV) ---\n","WIN = \"Hand Gesture Control\" # Define the window name\n","cv2.namedWindow(WIN, cv2.WINDOW_NORMAL) # Create a resizable window\n","\n","# --- Main Loop for Video Processing ---\n","while True:\n","    ok, img = cap.read() # Read a frame from the webcam\n","    if not ok: # If frame reading failed, break the loop\n","        print(\"Failed to read frame from webcam.\")\n","        break\n","    img = cv2.flip(img, 1) # Flip the image horizontally for a mirror effect\n","    h, w = img.shape[:2] # Get image height and width\n","    res = hands.process(cv2.cvtColor(img, cv2.COLOR_BGR2RGB)) # Process the image for hand landmarks (MediaPipe expects RGB)\n","\n","    # Check if hands are detected and classified\n","    if res.multi_hand_landmarks and res.multi_handedness:\n","        # Iterate through each detected hand\n","        for i, hand in enumerate(res.multi_hand_landmarks):\n","            # Get hand label (e.g., 'Left' or 'Right') - MediaPipe's label is based on the camera's view\n","            label = res.multi_handedness[i].classification[0].label\n","            # Draw hand landmarks and connections on the image\n","            draw.draw_landmarks(img, hand, Hands.HAND_CONNECTIONS)\n","            lm = hand.landmark # Get all landmarks for the current hand\n","\n","            # Get coordinates for thumb tip (TH) and index finger tip (IX)\n","            # Scale landmarks to image dimensions\n","            tp = (int(lm[TH].x*w), int(lm[TH].y*h))\n","            ip = (int(lm[IX].x*w), int(lm[IX].y*h))\n","\n","            # Draw circles on thumb and index finger tips\n","            cv2.circle(img, tp, 10, (255,0,0), cv2.FILLED)\n","            cv2.circle(img, ip, 10, (255,0,0), cv2.FILLED)\n","            # Draw a line connecting thumb and index finger tips\n","            cv2.line(img, tp, ip, (0,255,0), 3)\n","\n","            # Calculate the Euclidean distance between thumb and index finger tips\n","            # This distance will be used to control volume/brightness\n","            dist = float(np.hypot(ip[0]-tp[0], ip[1]-ip[0]))\n","\n","            # --- Control Logic based on hand label ---\n","            # 'Left' hand as identified by MediaPipe is typically the user's right hand in the flipped view\n","            if label == \"Left\":  # User's physical RIGHT hand -> Volume control\n","                # Map the hand gesture distance (e.g., 30-300 pixels) to the macOS volume range (0-100)\n","                volume_level = int(np.interp(dist, [30,300], [min_volume, max_volume]))\n","                try:\n","                    # Execute osascript command to set system volume\n","                    subprocess.call([\"osascript\", \"-e\", f\"set volume output volume {volume_level}\"])\n","                except Exception as e:\n","                    print(f\"Volume control error (osascript): {e}\")\n","\n","                # Visual feedback for volume control\n","                bar = int(np.interp(dist, [30,300], [400,150])) # Bar height for visual representation\n","                pct = int(np.interp(dist, [30,300], [0,100])) # Percentage for display\n","                cv2.rectangle(img, (50,150), (85,400), (255,0,0), 2) # Volume bar outline\n","                cv2.rectangle(img, (50,bar), (85,400), (255,0,0), cv2.FILLED) # Filled volume bar\n","                cv2.putText(img, f\"{pct}%\", (40,450), cv2.FONT_HERSHEY_SIMPLEX, 1, (255,0,0), 3) # Display percentage\n","\n","            # 'Right' hand as identified by MediaPipe is typically the user's left hand in the flipped view\n","            elif label == \"Right\":  # User's physical LEFT hand -> Brightness control\n","                # Map the hand gesture distance to the brightness range (0-100)\n","                brightness_percent = int(np.interp(dist, [30,300], [0,100]))\n","                # osascript for brightness expects a float between 0.0 and 1.0\n","                brightness_osascript = brightness_percent / 100.0\n","                try:\n","                    # Execute osascript command to set screen brightness\n","                    # This command targets 'System Events' to control the current display's brightness\n","                    subprocess.call([\"osascript\", \"-e\", f\"tell application \\\"System Events\\\" to set brightness of current display to {brightness_osascript}\"])\n","                except Exception as e:\n","                    print(f\"Brightness control error (osascript): {e}\")\n","\n","                # Visual feedback for brightness control\n","                bar = int(np.interp(dist, [30,300], [400,150])) # Bar height\n","                x1, x2 = w-85, w-50 # X-coordinates for the brightness bar\n","                cv2.rectangle(img, (x1,150), (x2,400), (0,255,0), 2) # Brightness bar outline\n","                cv2.rectangle(img, (x1,bar), (x2,400), (0,255,0), cv2.FILLED) # Filled brightness bar\n","                cv2.putText(img, f\"{brightness_percent}%\", (w-110,450), cv2.FONT_HERSHEY_SIMPLEX, 1, (0,255,0), 3) # Display percentage\n","\n","    # Display the processed image in the OpenCV window\n","    # NOTE: This cv2.imshow() will only work when run on a local desktop environment, not directly in Google Colab.\n","    # To view video output in Colab, you would need a different streaming approach or capture frames and display them statically.\n","    cv2.imshow(WIN, img)\n","\n","    # Wait for a key press (1ms) and get the key code\n","    k = cv2.waitKey(1) & 0xFF\n","    # If 'ESC' (27) or 'q' is pressed, break the loop and exit\n","    if k in (27, ord(\"q\")):\n","        break\n","    try:\n","        # Check if the OpenCV window was manually closed by the user\n","        if cv2.getWindowProperty(WIN, cv2.WND_PROP_VISIBLE) < 1:\n","            break\n","    except cv2.error: # Catch potential errors if the window was destroyed unexpectedly (e.g., by the OS)\n","        break\n","\n","# Release the webcam resource and close all OpenCV windows\n","cap.release()\n","cv2.destroyAllWindows()\n"]}]}