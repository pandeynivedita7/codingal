{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPGDC5phzKCqk5GYhtpvy2T"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"gN0OyaWZ2Fj3"},"outputs":[],"source":["# 01-head-tail.py\n","# Topic: The Head-Tail Pattern, Base Case for Lists\n","\n","# Prompt the user to press Enter to continue, introducing the head-tail concept.\n","input(\"Head-tail - head is lst[0]  tail is lst[1:]  base case is [].  Press Enter \")\n","\n","# Demonstrate the head and tail of a sample list [10, 20, 30].\n","# head: the first element (lst[0]), tail: all elements except the first (lst[1:]).\n","print(\"  [10, 20, 30]  head:\", [10, 20, 30][0], \"  tail:\", [10, 20, 30][1:])\n","\n","# Demonstrate the head and tail of another sample list [5, 15, 25].\n","print(\"  [5, 15, 25]   head:\", [5, 15, 25][0],  \"  tail:\", [5, 15, 25][1:])\n","\n","# Ask the user to enter three numbers separated by spaces.\n","# Convert these numbers to integers and store them in a list called 'lst'.\n","lst = [int(x) for x in input(\"Enter 3 numbers separated by spaces: \").split()]\n","\n","# Ask the user to guess the head of the list they just created.\n","guess = input(\"What is the head of \" + str(lst) + \"? \")\n","\n","# Prompt the user again to press Enter, reminding them of the head-tail definition.\n","input(\"Head is lst[0]  tail is lst[1:].  Press Enter \")\n","\n","# Display the actual head of the list and the user's guess for comparison.\n","print(\"  head:\", lst[0], \"  your guess:\", guess)\n"]},{"cell_type":"code","source":["# 02-list-sum.py\n","# Topic: Sorted Check with Recursion, Sum of a List with Recursion\n","\n","# Define a recursive function `list_sum` that calculates the sum of elements in a list.\n","def list_sum(lst):\n","    # Base case: If the list is empty, its sum is 0.\n","    if lst == []:\n","        return 0\n","    # Recursive step: Add the first element (head) to the sum of the rest of the list (tail).\n","    return lst[0] + list_sum(lst[1:])\n","\n","# Prompt the user to press Enter, explaining the recursive sum concept.\n","input(\"Recursive sum - add head to sum of tail until empty.  Press Enter \")\n","\n","# Demonstrate the `list_sum` function with a sample list [1, 2, 3].\n","print(\"  list_sum([1, 2, 3]) =\", list_sum([1, 2, 3]))\n","\n","# Demonstrate the `list_sum` function with another sample list [4, 5, 6].\n","print(\"  list_sum([4, 5, 6]) =\", list_sum([4, 5, 6]))\n","\n","# Ask the user to enter four numbers separated by spaces.\n","# Convert these numbers to integers and store them in a list called 'lst'.\n","lst = [int(x) for x in input(\"Enter 4 numbers separated by spaces: \").split()]\n","\n","# Ask the user to guess the sum of the list they just created.\n","guess = input(\"What is the sum of \" + str(lst) + \"? \")\n","\n","# Prompt the user again, reinforcing the recursive sum definition.\n","input(\"list_sum adds head to list_sum(tail) until the list is empty.  Press Enter \")\n","\n","# Display the actual sum of the list calculated by `list_sum` and the user's guess for comparison.\n","print(\"  sum:\", list_sum(lst), \"  your guess:\", guess)\n"],"metadata":{"id":"VAxkUwcl3FBx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 03-list-max.py\n","# Topic: Largest Element with Recursion\n","\n","# Define a recursive function `list_max` to find the largest element in a list.\n","def list_max(lst):\n","    # Base case: If the list contains only one element, that element is the largest.\n","    if len(lst) == 1:\n","        return lst[0]\n","    # Recursive step: Find the maximum of the rest of the list (tail).\n","    rest = list_max(lst[1:])\n","    # Compare the first element (head) with the maximum of the tail.\n","    # Return the larger of the two.\n","    return lst[0] if lst[0] > rest else rest\n","\n","# Prompt the user to press Enter, explaining the recursive max concept.\n","input(\"Recursive max - compare head to max of tail.  Press Enter \")\n","\n","# Demonstrate the `list_max` function with a sample list [3, 7, 2].\n","print(\"  list_max([3, 7, 2]) =\", list_max([3, 7, 2]))\n","\n","# Demonstrate the `list_max` function with another sample list [8, 1, 5].\n","print(\"  list_max([8, 1, 5]) =\", list_max([8, 1, 5]))\n","\n","# Ask the user to enter a number to be used as the first element of a new list.\n","n = int(input(\"Enter a number (try 6 or 15): \"))\n","\n","# Create a new list with the user's number and some fixed values.\n","lst = [n, 4, 9, 2]\n","\n","# Ask the user to guess the largest element in the newly created list.\n","guess = input(\"What is the largest in \" + str(lst) + \"? \")\n","\n","# Prompt the user again, reinforcing the recursive max definition.\n","input(\"list_max compares head to max of tail at each step.  Press Enter \")\n","\n","# Display the actual largest element calculated by `list_max` and the user's guess for comparison.\n","print(\"  largest:\", list_max(lst), \"  your guess:\", guess)\n"],"metadata":{"id":"iRzLYNrd4jMK"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Split a List into Head and Tail\n","numbers = [10, 20, 30, 40, 50]\n","\n","head = numbers[0]\n","tail = numbers[1:]\n","\n","print(\"Head:\", head)\n","print(\"Tail:\", tail)"],"metadata":{"id":"-7zeZuFh6U5u"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Check if a List is Sorted\n","def is_sorted(numbers):\n","    # Base case\n","    if len(numbers) <= 1:\n","        return True\n","\n","    # Compare first element with second element\n","    if numbers[0] > numbers[1]:\n","        return False\n","\n","    # Recursive call on the tail\n","    return is_sorted(numbers[1:])\n","\n","\n","numbers = [10, 20, 30, 40, 50]\n","\n","print(is_sorted(numbers))"],"metadata":{"id":"Cjm9t-nX6r9L"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Recursive Sum of a List\n","def list_sum(numbers):\n","    # Base case\n","    if len(numbers) == 0:\n","        return 0\n","\n","    # Head + sum of tail\n","    return numbers[0] + list_sum(numbers[1:])\n","\n","\n","numbers = [10, 20, 30, 40]\n","\n","print(\"Sum:\", list_sum(numbers))"],"metadata":{"id":"6_iIOsze7E4l"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#4. Find the Largest Element Recursively\n","def find_max(numbers):\n","    # Base case\n","    if len(numbers) == 1:\n","        return numbers[0]\n","\n","    # Find maximum of the tail\n","    max_of_tail = find_max(numbers[1:])\n","\n","    # Compare head with maximum of tail\n","    if numbers[0] > max_of_tail:\n","        return numbers[0]\n","    else:\n","        return max_of_tail\n","\n","\n","numbers = [15, 8, 42, 23, 10]\n","\n","print(\"Largest:\", find_max(numbers))"],"metadata":{"id":"FsPs4y0H7TRl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def is_sorted(numbers):\n","    if len(numbers) <= 1:\n","        return True\n","\n","    if numbers[0] > numbers[1]:\n","        return False\n","\n","    return is_sorted(numbers[1:])\n","\n","\n","def list_sum(numbers):\n","    if len(numbers) == 0:\n","        return 0\n","\n","    return numbers[0] + list_sum(numbers[1:])\n","\n","\n","def find_max(numbers):\n","    if len(numbers) == 1:\n","        return numbers[0]\n","\n","    max_of_tail = find_max(numbers[1:])\n","\n","    if numbers[0] > max_of_tail:\n","        return numbers[0]\n","    else:\n","        return max_of_tail\n","\n","\n","numbers = [10, 20, 30, 40, 50]\n","\n","print(\"List:\", numbers)\n","print(\"Is sorted?\", is_sorted(numbers))\n","print(\"Sum:\", list_sum(numbers))\n","print(\"Largest:\", find_max(numbers))"],"metadata":{"id":"IFJiIh8d7qWY"},"execution_count":null,"outputs":[]}]}